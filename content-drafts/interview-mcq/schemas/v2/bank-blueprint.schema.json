{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontendatlas.com/schemas/interview/v2/bank-blueprint.schema.json",
  "title": "FrontendAtlas interview bank blueprint v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "blueprintId",
    "bankId",
    "questionCount",
    "distributions",
    "competencyConstraint",
    "selectionPolicy",
    "codeOutputConstraint",
    "releaseReadiness"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "blueprintId": {
      "$ref": "#/$defs/slug"
    },
    "bankId": {
      "$ref": "#/$defs/slug"
    },
    "questionCount": {
      "type": "integer",
      "minimum": 1
    },
    "distributions": {
      "$ref": "#/$defs/distributions"
    },
    "competencyConstraint": {
      "$ref": "#/$defs/competencyConstraint"
    },
    "selectionPolicy": {
      "$ref": "#/$defs/selectionPolicy"
    },
    "codeOutputConstraint": {
      "$ref": "#/$defs/codeOutputConstraint"
    },
    "releaseReadiness": {
      "$ref": "#/$defs/releaseReadiness"
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "quota": {
      "type": "integer",
      "minimum": 0
    },
    "levelQuota": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "junior",
        "mid",
        "senior"
      ],
      "properties": {
        "junior": {
          "$ref": "#/$defs/quota"
        },
        "mid": {
          "$ref": "#/$defs/quota"
        },
        "senior": {
          "$ref": "#/$defs/quota"
        }
      }
    },
    "technologyQuota": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "javascript",
        "html",
        "css",
        "react",
        "angular",
        "vue"
      ],
      "properties": {
        "javascript": {
          "$ref": "#/$defs/quota"
        },
        "html": {
          "$ref": "#/$defs/quota"
        },
        "css": {
          "$ref": "#/$defs/quota"
        },
        "react": {
          "$ref": "#/$defs/quota"
        },
        "angular": {
          "$ref": "#/$defs/quota"
        },
        "vue": {
          "$ref": "#/$defs/quota"
        }
      }
    },
    "difficultyBandQuota": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "foundation",
        "core",
        "stretch"
      ],
      "properties": {
        "foundation": {
          "$ref": "#/$defs/quota"
        },
        "core": {
          "$ref": "#/$defs/quota"
        },
        "stretch": {
          "$ref": "#/$defs/quota"
        }
      }
    },
    "difficultyBandByLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "junior",
        "mid",
        "senior"
      ],
      "properties": {
        "junior": {
          "$ref": "#/$defs/difficultyBandQuota"
        },
        "mid": {
          "$ref": "#/$defs/difficultyBandQuota"
        },
        "senior": {
          "$ref": "#/$defs/difficultyBandQuota"
        }
      }
    },
    "technologyByLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "junior",
        "mid",
        "senior"
      ],
      "properties": {
        "junior": {
          "$ref": "#/$defs/technologyQuota"
        },
        "mid": {
          "$ref": "#/$defs/technologyQuota"
        },
        "senior": {
          "$ref": "#/$defs/technologyQuota"
        }
      }
    },
    "formatQuota": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conceptual",
        "code-output",
        "production-scenario"
      ],
      "properties": {
        "conceptual": {
          "$ref": "#/$defs/quota"
        },
        "code-output": {
          "$ref": "#/$defs/quota"
        },
        "production-scenario": {
          "$ref": "#/$defs/quota"
        }
      }
    },
    "formatByLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "junior",
        "mid",
        "senior"
      ],
      "properties": {
        "junior": {
          "$ref": "#/$defs/formatQuota"
        },
        "mid": {
          "$ref": "#/$defs/formatQuota"
        },
        "senior": {
          "$ref": "#/$defs/formatQuota"
        }
      }
    },
    "correctOptionPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first",
        "second",
        "third"
      ],
      "properties": {
        "first": {
          "$ref": "#/$defs/quota"
        },
        "second": {
          "$ref": "#/$defs/quota"
        },
        "third": {
          "$ref": "#/$defs/quota"
        }
      }
    },
    "distributions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "technology",
        "technologyByLevel",
        "difficultyBandByLevel",
        "formatByLevel",
        "correctOptionPosition"
      ],
      "properties": {
        "level": {
          "$ref": "#/$defs/levelQuota"
        },
        "technology": {
          "$ref": "#/$defs/technologyQuota"
        },
        "technologyByLevel": {
          "$ref": "#/$defs/technologyByLevel"
        },
        "difficultyBandByLevel": {
          "$ref": "#/$defs/difficultyBandByLevel"
        },
        "formatByLevel": {
          "$ref": "#/$defs/formatByLevel"
        },
        "correctOptionPosition": {
          "$ref": "#/$defs/correctOptionPosition"
        }
      }
    },
    "competencyConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distinctByTechnology"
      ],
      "properties": {
        "distinctByTechnology": {
          "$ref": "#/$defs/technologyQuota"
        }
      }
    },
    "selectionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionQuestionCount",
        "coreQuestionsPerSession",
        "frameworkQuestionsPerSession",
        "coreTechnologies",
        "frameworkTechnologies",
        "eligiblePoolByLevelAndTrack"
      ],
      "properties": {
        "sessionQuestionCount": {
          "const": 5
        },
        "coreQuestionsPerSession": {
          "const": 3
        },
        "frameworkQuestionsPerSession": {
          "const": 2
        },
        "coreTechnologies": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "javascript",
              "html",
              "css"
            ]
          }
        },
        "frameworkTechnologies": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "react",
              "angular",
              "vue"
            ]
          }
        },
        "eligiblePoolByLevelAndTrack": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "junior",
            "mid",
            "senior"
          ],
          "properties": {
            "junior": {
              "$ref": "#/$defs/trackPoolQuota"
            },
            "mid": {
              "$ref": "#/$defs/trackPoolQuota"
            },
            "senior": {
              "$ref": "#/$defs/trackPoolQuota"
            }
          }
        }
      }
    },
    "trackPoolQuota": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core-web",
        "react",
        "angular",
        "vue"
      ],
      "properties": {
        "core-web": {
          "$ref": "#/$defs/quota"
        },
        "react": {
          "$ref": "#/$defs/quota"
        },
        "angular": {
          "$ref": "#/$defs/quota"
        },
        "vue": {
          "$ref": "#/$defs/quota"
        }
      }
    },
    "releaseReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attemptsWithoutLiteralOrSemanticRepeat",
        "adjacentOverlapMaximum",
        "sessionBudgetSecondsByLevel",
        "formProfiles",
        "candidateCapacityPlan"
      ],
      "properties": {
        "attemptsWithoutLiteralOrSemanticRepeat": {
          "const": 5
        },
        "adjacentOverlapMaximum": {
          "const": 0
        },
        "sessionBudgetSecondsByLevel": {
          "$ref": "#/$defs/positiveLevelQuota"
        },
        "formProfiles": {
          "$ref": "#/$defs/formProfiles"
        },
        "candidateCapacityPlan": {
          "$ref": "#/$defs/candidateCapacityPlan"
        }
      }
    },
    "positiveLevelQuota": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "junior",
        "mid",
        "senior"
      ],
      "properties": {
        "junior": {
          "type": "integer",
          "minimum": 1
        },
        "mid": {
          "type": "integer",
          "minimum": 1
        },
        "senior": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "trackTechnologyCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core-web",
        "react",
        "angular",
        "vue"
      ],
      "properties": {
        "core-web": {
          "$ref": "#/$defs/technologyQuota"
        },
        "react": {
          "$ref": "#/$defs/technologyQuota"
        },
        "angular": {
          "$ref": "#/$defs/technologyQuota"
        },
        "vue": {
          "$ref": "#/$defs/technologyQuota"
        }
      }
    },
    "trackBandCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core-web",
        "react",
        "angular",
        "vue"
      ],
      "properties": {
        "core-web": {
          "$ref": "#/$defs/difficultyBandQuota"
        },
        "react": {
          "$ref": "#/$defs/difficultyBandQuota"
        },
        "angular": {
          "$ref": "#/$defs/difficultyBandQuota"
        },
        "vue": {
          "$ref": "#/$defs/difficultyBandQuota"
        }
      }
    },
    "trackBandCountsByLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "junior",
        "mid",
        "senior"
      ],
      "properties": {
        "junior": {
          "$ref": "#/$defs/trackBandCounts"
        },
        "mid": {
          "$ref": "#/$defs/trackBandCounts"
        },
        "senior": {
          "$ref": "#/$defs/trackBandCounts"
        }
      }
    },
    "formProfiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technologyCountsByTrack",
        "difficultyBandCountsByLevelAndTrack",
        "minimumProductionScenarioCount",
        "maximumCodeOutputCount"
      ],
      "properties": {
        "technologyCountsByTrack": {
          "$ref": "#/$defs/trackTechnologyCounts"
        },
        "difficultyBandCountsByLevelAndTrack": {
          "$ref": "#/$defs/trackBandCountsByLevel"
        },
        "minimumProductionScenarioCount": {
          "const": 1
        },
        "maximumCodeOutputCount": {
          "const": 1
        }
      }
    },
    "candidateCapacityLevelPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumNetNewItems",
        "minimumByTechnology",
        "minimumByDifficultyBand"
      ],
      "properties": {
        "minimumNetNewItems": {
          "type": "integer",
          "minimum": 0
        },
        "minimumByTechnology": {
          "$ref": "#/$defs/technologyQuota"
        },
        "minimumByDifficultyBand": {
          "$ref": "#/$defs/difficultyBandQuota"
        }
      }
    },
    "candidateCapacityByLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "junior",
        "mid",
        "senior"
      ],
      "properties": {
        "junior": {
          "$ref": "#/$defs/candidateCapacityLevelPlan"
        },
        "mid": {
          "$ref": "#/$defs/candidateCapacityLevelPlan"
        },
        "senior": {
          "$ref": "#/$defs/candidateCapacityLevelPlan"
        }
      }
    },
    "candidateCapacityPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "baselineQuestionCount",
        "minimumTargetQuestionCount",
        "minimumNetNewItems",
        "byLevel"
      ],
      "properties": {
        "scope": {
          "const": "literal-and-semantic-repeat-capacity-only"
        },
        "baselineQuestionCount": {
          "const": 170
        },
        "minimumTargetQuestionCount": {
          "const": 185
        },
        "minimumNetNewItems": {
          "const": 15
        },
        "byLevel": {
          "$ref": "#/$defs/candidateCapacityByLevel"
        }
      }
    },
    "codeOutputConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "technology",
        "codeLanguage",
        "runtime",
        "verificationKind"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "technology": {
          "const": "javascript"
        },
        "codeLanguage": {
          "const": "javascript"
        },
        "runtime": {
          "const": "browser"
        },
        "verificationKind": {
          "const": "browser-console-output"
        }
      }
    }
  }
}
