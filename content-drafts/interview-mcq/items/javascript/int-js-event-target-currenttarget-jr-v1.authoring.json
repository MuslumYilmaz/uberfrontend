    "prompt": "What does the delegated click handler log, in order, in a standards-compliant browser?",
    "code": {
      "language": "javascript",
      "runtime": "browser",
      "source": "const list = document.createElement('div');\nconst button = document.createElement('button');\nlist.append(button);\n\nlist.addEventListener('click', (event) => {\n  console.log(event.target.tagName);\n  console.log(event.currentTarget.tagName);\n});\n\nbutton.click();"
    },
    "options": [
      {
        "id": "choice-a72cdba8d3",
        "label": "DIV → DIV"
      },
      {
        "id": "choice-7857d2ac10",
        "label": "BUTTON → BUTTON"
      },
      {
        "id": "choice-30484588aa",
        "label": "BUTTON → DIV"
      }
    ],
    "estimatedSeconds": 90
  },
  "private": {
    "correctOptionId": "choice-30484588aa",
    "answerProof": {
      "summary": "The button originates the event, while the bubbling listener executes on the containing div.",
      "decisiveConstraints": [
        "The click originates on the button.",
        "The registered listener belongs to the div."
      ],
      "claims": [
        {
          "statement": "`target` identifies where the event was dispatched, whereas `currentTarget` identifies the element whose handler is running.",
          "sourceIds": [
            "mdn-event-target",
            "mdn-event-currenttarget"
          ]
        }
      ]
    },
    "optionRationales": [
      {
        "optionId": "choice-a72cdba8d3",
        "verdict": "incorrect",
        "explanation": "The listener owner is the div, but the original clicked target remains the button while the event bubbles.",
        "misconceptionTag": "bubbling-rewrites-event-target",
        "plausibility": "Both values are read while the div's listener is executing.",
        "falsifyingConstraint": "Bubbling does not replace the event's originating target."
      },
      {
        "optionId": "choice-7857d2ac10",
        "verdict": "incorrect",
        "explanation": "The button is the target, but it is not the element on which this listener was registered.",
        "misconceptionTag": "currenttarget-equals-clicked-node",
        "plausibility": "The event started on the button and carries that node as its target.",
        "falsifyingConstraint": "The callback is attached to the containing div, making that div currentTarget."
      },
      {
        "optionId": "choice-30484588aa",
        "verdict": "correct",
        "explanation": "`target` is the button that was clicked and `currentTarget` is the div handling the bubbled event.",
