{
  "schemaVersion": "1.0.0",
  "id": "order-book-pressure-v1",
  "family": "order-book",
  "title": "Order Book Interview Pressure Mode",
  "access": "premium",
  "estimatedMinutes": 45,
  "supportedQuestions": {
    "react": "react-order-book-socket-feed"
  },
  "rounds": [
    {
      "id": "snapshot-and-deltas",
      "title": "Snapshot, then deltas",
      "interviewerPrompt": "Load the snapshot and keep the book current as deltas arrive. Show the best ten levels per side, best first, with the spread and the seq of the newest message the book includes.",
      "constraints": [
        "Call `fetchSnapshot()` on the connection the starter opens, then apply every message from the socket. A message's `size` is the new total at that price; 0 removes the level.",
        "Show at most ten `.bid` and ten `.ask` rows, each with `.price` (two decimals) and `.size`. Bids go highest first, asks lowest first.",
        "Show the spread, best ask minus best bid with two decimals, as `Spread 1.00` in `.spread`, and `Last update #N` in `.last-seq` for the newest message the book includes: a snapshot's `lastSeq` when it loads, then each applied seq.",
        "Show `Loading snapshot…` in `.sync-status` until the first snapshot arrives, then `Live`."
      ],
      "frameworkTests": [
        {
          "id": "pressure-book-snapshot-first-paint",
          "name": "Round 1 · The snapshot paints the best ten levels per side, best first",
          "steps": [
            {
              "type": "expectText",
              "selector": ".sync-status",
              "text": "Loading snapshot",
              "match": "contains"
            },
            {
              "type": "expectCount",
              "selector": ".bid",
              "count": 0
            },
            {
              "type": "waitForCount",
              "selector": ".bid",
              "count": 10,
              "timeoutMs": 2500
            },
            {
              "type": "expectCount",
              "selector": ".ask",
              "count": 10
            },
            {
              "type": "expectText",
              "selector": ".bid .price",
              "index": 0,
              "text": "99.50",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".bid .size",
              "index": 0,
              "text": "12",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".ask .price",
              "index": 0,
              "text": "100.50",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".ask .size",
              "index": 0,
              "text": "13",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".bid .price",
              "index": 9,
              "text": "94.50",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".ask .price",
              "index": 9,
              "text": "105.00",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".spread",
              "text": "Spread 1.00",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".sync-status",
              "text": "Live",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".last-seq",
              "text": "Last update #1000",
              "match": "equals"
            }
          ]
        },
        {
          "id": "pressure-book-applies-deltas",
          "name": "Round 1 · The book follows the deltas while they stream, not only at the end",
          "steps": [
            {
              "type": "waitForCount",
              "selector": ".bid",
              "count": 10,
              "timeoutMs": 2500
            },
            {
              "type": "waitForText",
              "selector": ".spread",
              "text": "Spread 1.50",
              "match": "equals",
              "timeoutMs": 2500
            },
            {
              "type": "expectText",
              "selector": ".ask .price",
              "index": 0,
              "text": "101.00",
              "match": "equals"
            },
            {
              "type": "waitForText",
              "selector": ".last-seq",
              "text": "#101",
              "match": "contains",
              "timeoutMs": 2500
            },
            {
              "type": "waitForText",
              "selector": ".last-seq",
              "text": "Last update #1030",
              "match": "equals",
              "timeoutMs": 4000
            },
            {
              "type": "expectCount",
              "selector": ".bid",
              "count": 10
            },
            {
              "type": "expectCount",
              "selector": ".ask",
              "count": 10
            },
            {
              "type": "expectText",
              "selector": ".bid .price",
              "index": 0,
              "text": "100.00",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".bid .size",
              "index": 0,
              "text": "18",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".bid .size",
              "index": 1,
              "text": "9",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".ask .price",
              "index": 0,
              "text": "101.00",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".ask .size",
              "index": 2,
              "text": "5",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".bid .price",
              "index": 9,
              "text": "94.50",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".ask .price",
              "index": 9,
              "text": "105.50",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".spread",
              "text": "Spread 1.00",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".bid .price",
              "index": 4,
              "text": "98.00",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".ask .price",
              "index": 4,
              "text": "103.00",
              "match": "equals"
            }
          ]
        }
