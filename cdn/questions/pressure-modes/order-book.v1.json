    {
      "id": "sequence-and-resync",
      "title": "Trust the sequence numbers",
      "interviewerPrompt": "The snapshot can arrive after the first messages, and the socket can lose one. Use the seq numbers so the book is never wrong, and recover from a lost message without blanking the screen.",
      "constraints": [
        "Keep messages that arrive before the snapshot. Skip the ones it already includes (seq at or below `lastSeq`) and apply the rest in the order they arrive; the socket sends them in seq order, so a jump past the next seq is a gap.",
        "When a seq is missing, show `Resyncing…` at once, keep the last book on screen, and ask the same connection for a new snapshot with `fetchSnapshot()`; opening a new connection replays the scenario from the start.",
        "Count resyncs in `.resync-count`: `0 resyncs`, `1 resync`, `N resyncs`. A late first snapshot is not a resync.",
        "Switching the scenario clears the book at once and starts again with `Loading snapshot…`, `Last update —` and `0 resyncs`."
      ],
      "frameworkTests": [
        {
          "id": "pressure-book-late-snapshot",
          "name": "Round 2 · Messages sent before a late snapshot are kept, with no resync",
          "steps": [
            {
              "type": "waitForCount",
              "selector": ".bid",
              "count": 10,
              "timeoutMs": 2500
            },
            {
              "type": "setValue",
              "selector": ".scenario",
              "value": "late-snapshot"
            },
            {
              "type": "waitForCount",
              "selector": ".bid",
              "count": 0,
              "timeoutMs": 500
            },
            {
              "type": "waitForText",
              "selector": ".last-seq",
              "text": "Last update —",
              "match": "equals",
              "timeoutMs": 500
            },
            {
              "type": "expectText",
              "selector": ".sync-status",
              "text": "Loading snapshot",
              "match": "contains"
            },
            {
              "type": "waitForText",
              "selector": ".last-seq",
              "text": "Last update #1030",
              "match": "equals",
              "timeoutMs": 4000
            },
            {
              "type": "expectText",
              "selector": ".ask .price",
              "index": 0,
              "text": "101.00",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".bid .price",
              "index": 9,
              "text": "94.50",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".bid .price",
              "index": 0,
              "text": "100.00",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".ask .size",
              "index": 2,
              "text": "5",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".resync-count",
              "text": "0 resyncs",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".sync-status",
              "text": "Live",
              "match": "equals"
            }
          ]
        },
        {
          "id": "pressure-book-gap-resync",
          "name": "Round 2 · A lost message starts one resync, the book stays up meanwhile, and a switch resets the count",
          "steps": [
            {
              "type": "waitForCount",
              "selector": ".bid",
              "count": 10,
              "timeoutMs": 2500
            },
            {
              "type": "setValue",
              "selector": ".scenario",
              "value": "gap"
            },
            {
              "type": "waitForCount",
              "selector": ".bid",
              "count": 10,
              "timeoutMs": 2500
            },
            {
              "type": "waitForText",
              "selector": ".sync-status",
              "text": "Resyncing",
              "match": "contains",
              "timeoutMs": 3000
            },
            {
              "type": "expectCount",
              "selector": ".bid",
              "count": 10
            },
            {
              "type": "wait",
              "durationMs": 100
            },
            {
              "type": "expectText",
              "selector": ".last-seq",
              "text": "Last update #1011",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".sync-status",
              "text": "Resyncing",
              "match": "contains"
            },
            {
              "type": "expectCount",
              "selector": ".bid",
              "count": 10
            },
            {
              "type": "waitForText",
              "selector": ".sync-status",
              "text": "Live",
              "match": "equals",
              "timeoutMs": 2500
            },
            {
              "type": "waitForText",
              "selector": ".last-seq",
              "text": "Last update #1030",
              "match": "equals",
              "timeoutMs": 3000
            },
            {
              "type": "expectText",
              "selector": ".bid .price",
              "index": 0,
              "text": "100.00",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".bid .size",
              "index": 0,
              "text": "18",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".ask .price",
              "index": 0,
              "text": "101.00",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".bid .price",
              "index": 9,
              "text": "94.50",
              "match": "equals"
            },
            {
              "type": "expectText",
              "selector": ".resync-count",
              "text": "1 resync",
              "match": "equals"
            },
            {
              "type": "setValue",
              "selector": ".scenario",
              "value": "steady"
            },
            {
              "type": "waitForText",
              "selector": ".resync-count",
              "text": "0 resyncs",
              "match": "equals",
              "timeoutMs": 1000
            }
          ]
