    {
      "id": "select-many",
      "title": "Select many at once",
      "interviewerPrompt": "Lists get long. Let the user select everything at once and see how many are selected.",
      "constraints": [
        "Add a checkbox with the class `select-all` to each list, outside the rows. It selects or clears every row in that list.",
        "It is checked when every row is selected and unchecked when none are. Otherwise it is indeterminate, and clicking it selects all. Use the checkbox's `indeterminate` property.",
        "An empty list disables its `select-all`, and it is not checked.",
        "Show the count in an element with the class `selection-count`, for example `2 of 5 selected`."
      ],
      "frameworkTests": [
        {
          "id": "pressure-transfer-select-all",
          "name": "Round 2 · Select all reflects the rows",
          "steps": [
            {
              "type": "expectText",
