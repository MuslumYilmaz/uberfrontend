{
  "schemaVersion": "1.0.0",
  "id": "transfer-list-pressure-v1",
  "family": "transfer-list",
  "title": "Transfer List Interview Pressure Mode",
  "access": "premium",
  "estimatedMinutes": 45,
  "supportedQuestions": {
    "react": "react-transfer-list",
    "angular": "angular-transfer-list",
    "vue": "vue-transfer-list"
