  "rounds": [
    {
      "id": "move-between-lists",
      "title": "Move items between lists",
      "interviewerPrompt": "Build the two lists first. An item lives in exactly one list, and moving it must never change the order of anything else.",
      "constraints": [
        "Checking a row selects that item. The `move down` button moves the selected Top items to Bottom, and `move up` moves the selected Bottom items to Top.",
        "Moved items go to the end of the other list, in the order they had.",
        "Each button is disabled when its list has nothing selected.",
        "A move clears the selection of the list it came from. The selection in the other list stays, and moved items arrive unselected.",
        "Keep the starter classes `listCard`, `row` and `empty`, and show `Empty` when a list has no items."
      ],
      "frameworkTests": [
        {
          "id": "pressure-transfer-move",
          "name": "Round 1 · Items move in order and the selection stays honest",
          "steps": [
            {
              "type": "expectDisabled",
              "selector": "[aria-label=\"move down\"]",
              "disabled": true
            },
            {
              "type": "expectDisabled",
              "selector": "[aria-label=\"move up\"]",
              "disabled": true
            },
            {
              "type": "click",
              "selector": ".listCard:first-child .row input",
              "index": 2
            },
            {
              "type": "click",
              "selector": ".listCard:first-child .row input",
              "index": 1
            },
            {
              "type": "click",
              "selector": ".listCard:last-child .row input",
              "index": 0
            },
            {
              "type": "expectDisabled",
              "selector": "[aria-label=\"move down\"]",
              "disabled": false
            },
            {
              "type": "expectDisabled",
              "selector": "[aria-label=\"move up\"]",
              "disabled": false
            },
            {
              "type": "click",
              "selector": "[aria-label=\"move down\"]"
            },
            {
