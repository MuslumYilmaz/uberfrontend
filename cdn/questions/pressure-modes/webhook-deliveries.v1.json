  "debrief": {
    "title": "You shipped four tasks under the clock",
    "summary": "You took a small React and TypeScript app from a bare fetch to a console that shows one request state at a time, types its payload, filters and retries rows, and refreshes without losing them. The interview signal is the order you worked in and the bug you found on the way: a handler that captured the first source and never saw another.",
    "takeaways": [
      "Hold one request state object and derive the screen from it; separate booleans drift apart under time pressure.",
      "Number every request and compare the number when it settles, so a stale source can never paint the screen.",
      "Narrow an unknown payload with type guards and count what you drop; a cast hides the five records that break the table.",
      "A refresh is not a first load: it has rows worth keeping, and it must read the current source, not the one a stale closure remembers."
    ],
    "frameworkNotes": {
      "react": "A `useCallback` with an empty dependency list captures the first render's `source`. Reading the state in a plain handler, or listing it in the dependencies, fixes the refresh; a ref holding the latest request id keeps older answers out."
    }
  },
