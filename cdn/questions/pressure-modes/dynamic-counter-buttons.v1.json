    {
      "id": "core-grow-invariants",
      "title": "Core grow invariants",
      "interviewerPrompt": "Start with one stable counter and grow the list without losing independent values. Every activation must update exactly one existing item before capacity allows one new item.",
      "constraints": [
        "Start with exactly one counter object whose id is 1 and whose count is 0.",
        "Activating a counter must increment only that counter and append one zero-value counter while the current limit has room.",
        "Allocate monotonically increasing ids so rendered position is never the source of counter identity.",
        "Derive the visible counter count and combined value from the current collection."
      ],
      "frameworkTests": [
        {
          "id": "pressure-dynamic-counters-core",
          "name": "Round 1 · Independent values grow with stable identities",
          "steps": [
            {
              "type": "expectValue",
              "selector": "#counter-limit",
              "value": "5"
            },
            {
              "type": "expectCount",
              "selector": ".counter-row",
              "count": 1
            },
            {
              "type": "expectAttribute",
              "selector": ".counter-row",
              "index": 0,
              "attribute": "data-counter-id",
              "expected": "1"
            },
            {
              "type": "expectText",
              "selector": ".counter-value",
              "index": 0,
              "text": "0"
            },
            {
              "type": "expectText",
