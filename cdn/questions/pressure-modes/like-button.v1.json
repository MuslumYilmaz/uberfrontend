  "rounds": [
    {
      "id": "update-first",
      "title": "Update first, save after",
      "interviewerPrompt": "The like has to reach a server now. The button must answer at once, even though the server takes time.",
      "constraints": [
        "Add a function named `saveLike(liked)` that returns a promise and resolves after 400 ms. This is your fake server.",
        "A click updates `label`, `aria-pressed` and `count` right away, before the save finishes. Liking adds 1 and unliking removes 1.",
        "While a save runs, show `Saving…` in an element with the class `save-status`. When it finishes, show `Saved`.",
        "Keep the starter classes `likeBtn`, `label` and `count`. The count starts at 120."
      ],
      "frameworkTests": [
        {
          "id": "pressure-like-instant",
          "name": "Round 1 · The screen answers before the server does",
          "steps": [
            {
              "type": "expectText",
              "selector": ".label",
              "text": "Like"
            },
            {
              "type": "expectText",
              "selector": ".count",
              "text": "120"
            },
            {
              "type": "expectAttribute",
              "selector": ".likeBtn",
              "attribute": "aria-pressed",
              "expected": "false"
            },
            {
              "type": "click",
              "selector": ".likeBtn"
            },
            {
              "type": "expectText",
              "selector": ".label",
              "text": "Liked"
            },
            {
              "type": "expectAttribute",
              "selector": ".likeBtn",
              "attribute": "aria-pressed",
              "expected": "true"
            },
            {
              "type": "expectText",
              "selector": ".count",
              "text": "121"
            },
            {
              "type": "expectText",
              "selector": ".save-status",
              "text": "Saving…"
            },
            {
              "type": "waitForText",
              "selector": ".save-status",
              "text": "Saved",
              "timeoutMs": 800
            },
            {
              "type": "expectText",
              "selector": ".label",
              "text": "Liked"
            },
            {
              "type": "expectText",
              "selector": ".count",
              "text": "121"
            },
            {
              "type": "click",
              "selector": ".likeBtn"
            },
            {
              "type": "expectText",
              "selector": ".label",
              "text": "Like"
            },
            {
              "type": "expectAttribute",
              "selector": ".likeBtn",
              "attribute": "aria-pressed",
              "expected": "false"
            },
            {
              "type": "expectText",
              "selector": ".count",
              "text": "120"
            },
            {
              "type": "expectText",
              "selector": ".save-status",
              "text": "Saving…"
            },
            {
              "type": "waitForText",
              "selector": ".save-status",
              "text": "Saved",
              "timeoutMs": 800
            }
          ]
        }
      ]
    },
    {
