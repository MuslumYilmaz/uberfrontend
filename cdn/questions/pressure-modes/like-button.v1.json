{
  "schemaVersion": "1.0.0",
  "id": "like-button-pressure-v1",
  "family": "like-button",
  "title": "Like Button Interview Pressure Mode",
  "access": "premium",
  "estimatedMinutes": 45,
  "supportedQuestions": {
    "react": "react-like-button",
    "angular": "angular-like-button",
    "vue": "vue-like-button"
