  "debrief": {
    "title": "You kept the button fast and the server honest",
    "summary": "You made a small button answer at once, recover from failures, survive fast clicks and clean up after itself. The interview signal is separating what the screen shows from what the server has accepted.",
    "takeaways": [
      "Update the screen first, then save, and keep the last value the server accepted.",
      "On failure go back to that accepted value, not to the previous click.",
      "Send one save at a time, and send the latest value only when it differs.",
      "Give every timer one owner, so an old one cannot change a newer message."
    ],
    "frameworkNotes": {
      "react": "A ref holds the accepted value and the waiting value, because the save callback must read the latest ones, not the values from the render that started it.",
      "angular": "Plain class fields hold the accepted and waiting values, and `ngOnDestroy` stops the running timer.",
      "vue": "Keep the accepted and waiting values outside template state, and stop the running timer in `onUnmounted`."
    }
  },
