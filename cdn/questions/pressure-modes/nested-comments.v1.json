  "debrief": {
    "title": "You kept the thread correct as it grew",
    "summary": "You grew a simple reply form into a real thread: focus stays in place, hidden threads count correctly, and delete keeps other people's replies. The interview signal is treating the tree as data and updating it the same way at any depth.",
    "takeaways": [
      "Walk the tree with one recursive helper instead of writing special cases for each depth.",
      "Derive reply counts from the tree so they can never go out of date.",
      "Keep drafts and hidden threads by comment id, not by position.",
      "After a comment is removed, decide where focus goes, because the focused button no longer exists."
    ],
    "frameworkNotes": {
      "react": "Render the tree with a plain recursive function or a component defined outside App. A component created inside App gets a new identity on every render, so React rebuilds the inputs and the user loses focus after every letter.",
      "angular": "A recursive `ng-template` with `track comment.id` keeps each row stable, and running change detection before focusing makes sure the target element exists.",
      "vue": "A recursive component keeps each row stable by key, and `nextTick` moves focus after the DOM updates."
    }
  },
