  ],
  "debrief": {
    "title": "You kept dynamic board state predictable under pressure",
    "summary": "You preserved size boundaries, single selection, derived queen reachability, and accessible grid focus while the board changed shape.",
    "takeaways": [
      "Keep board size and selected coordinates as the source state and derive color, queen reachability, labels, and counts from them.",
      "Treat resize as one bounded transition that clears coordinate-dependent selection and focus state.",
      "Derive queen movement with same-row, same-column, or equal row-and-column distance checks while excluding the selected cell.",
      "Keep roving focus independent from selection so navigation never changes highlighted board state."
    ],
    "frameworkNotes": {
      "react": "Use memoized rows and cells, derive queen reachability from selected coordinates, and keep stable button refs for roving focus.",
      "angular": "Use derived getters for board cells and queen reachability, and move focus through ViewChildren cell references after bounded size changes.",
      "vue": "Use computed board and reachability state, and keep a template-ref collection for roving focus across dynamic sizes."
    }
  },
