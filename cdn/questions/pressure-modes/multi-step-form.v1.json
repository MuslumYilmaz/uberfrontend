  "debrief": {
    "title": "You kept the signup moving without losing anything",
    "summary": "You built a flow that explains what is missing, keeps what the user typed, returns from edits, grows a step when needed and tells keyboard users where they are. The interview signal is deriving the steps from data instead of fixing them in the code.",
    "takeaways": [
      "Derive the list of steps from the form data, and let everything else read that list.",
      "Keep the user's values in one place, so moving between steps can never lose them.",
      "Treat editing as its own state, and clear it when the user returns.",
      "Move focus when the screen changes, because the button the user pressed may be gone."
    ],
    "frameworkNotes": {
      "react": "Keep one form object and derive the steps during render. An effect keyed on the current step moves focus after the new step is on the page.",
      "angular": "Nested form groups keep every value while the step template changes. `Validators.required` accepts spaces, so trim first, and run change detection before moving focus.",
      "vue": "A computed list of steps replaces fixed numbers, and `nextTick` moves focus after the DOM updates."
    }
  },
