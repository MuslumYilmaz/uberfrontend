    "package.json": "{\"name\":\"vue-chips-input-autocomplete\",\"version\":\"0.1.0\",\"private\":true,\"dependencies\":{\"vue\":\"3.x\"},\"scripts\":{\"serve\":\"vue-cli-service serve\"}}\n",
    "public/index.html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Vue SDK • Invite Chips</title></head><body><div id=\"app\"></div></body></html>",
    "src/main.ts": "import { createApp } from 'vue';\nimport App from './App.vue';\nimport './App.css';\n\ncreateApp(App).mount('#app');\n",
    "src/App.vue": "<template>\n  <main class=\"page\">\n    <section class=\"card\">\n      <h1>Invite people</h1>\n      <p class=\"subtitle\">\n        Build a chips input with autocomplete, keyboard shortcuts, and removable tags.\n      </p>\n\n      <div\n        ref=\"rootRef\"\n        class=\"combobox\"\n        role=\"combobox\"\n        :aria-expanded=\"isOpen\"\n        aria-haspopup=\"listbox\"\n        :aria-owns=\"listboxId\"\n        :aria-activedescendant=\"activeDescendant\"\n      >\n        <div class=\"chip-input\">\n          <span class=\"chip\" v-for=\"chip in chips\" :key=\"chip.id\">\n            <span>{{ chip.label }}</span>\n            <button\n              type=\"button\"\n              class=\"chip-remove\"\n              @click=\"removeChip(chip.id)\"\n              :aria-label=\"'Remove ' + chip.label\"\n            >\n              ×\n            </button>\n          </span>\n\n          <input\n            type=\"text\"\n            v-model=\"query\"\n            @focus=\"onFocus\"\n            @keydown=\"onKeyDown\"\n            placeholder=\"Type a name or email...\"\n          />\n        </div>\n\n        <ul v-if=\"isOpen\" :id=\"listboxId\" class=\"suggestions\" role=\"listbox\">\n          <li\n            v-for=\"(item, index) in suggestions\"\n            :key=\"item.id\"\n            :id=\"optionId(index)\"\n            role=\"option\"\n            :aria-selected=\"index === activeIndex\"\n            class=\"suggestion\"\n            :class=\"{ active: index === activeIndex }\"\n            @mousedown=\"selectSuggestion(item)\"\n          >\n            <strong>{{ item.label }}</strong>\n            <span>{{ item.value }}</span>\n          </li>\n        </ul>\n      </div>\n\n      <p class=\"hint\">\n        Keyboard: Arrow keys navigate, Enter/comma add chip, Backspace removes the last chip.\n      </p>\n    </section>\n  </main>\n</template>\n\n<script setup lang=\"ts\">\nimport { computed, onBeforeUnmount, onMounted, ref, watch } from 'vue';\n\ntype Candidate = {\n  id: string;\n  name: string;\n  email: string;\n};\n\ntype Chip = {\n  id: string;\n  label: string;\n  value: string;\n};\n\nconst USERS: Candidate[] = [\n  { id: 'alice', name: 'Alice Johnson', email: 'alice@frontendatlas.dev' },\n  { id: 'bob', name: 'Bob Smith', email: 'bob@frontendatlas.dev' },\n  { id: 'charlie', name: 'Charlie Kim', email: 'charlie@frontendatlas.dev' },\n  { id: 'diana', name: 'Diana Lopez', email: 'diana@frontendatlas.dev' },\n  { id: 'ethan', name: 'Ethan Brown', email: 'ethan@frontendatlas.dev' },\n  { id: 'fiona', name: 'Fiona Patel', email: 'fiona@frontendatlas.dev' },\n  { id: 'george', name: 'George Miller', email: 'george@frontendatlas.dev' }\n];\n\nconst rootRef = ref<HTMLElement | null>(null);\nconst listboxId = 'invite-suggestions';\n\nconst chips = ref<Chip[]>([]);\nconst query = ref('');\nconst isOpen = ref(false);\nconst activeIndex = ref(-1);\n\nconst suggestions = computed<Chip[]>(() => {\n  // TODO:\n  // 1) trim+lower query\n  // 2) filter USERS by name/email includes query\n  // 3) remove users already selected in chips\n  // 4) map to Chip shape + limit to 6\n  return [];\n});\n\nconst activeDescendant = computed(() =>\n  activeIndex.value >= 0 ? optionId(activeIndex.value) : undefined\n);\n\nfunction addChip(chip: Chip) {\n  // TODO: prevent duplicates by id or normalized value\n  // then append chip, clear query, close dropdown, reset active index\n}\n\nfunction addCustomFromQuery() {\n  // TODO: if query has text, create custom chip: id='custom-'+normalize(query)\n  // and call addChip(...)\n}\n\nfunction removeChip(chipId: string) {\n  // TODO: remove chip by id\n}\n\nfunction selectSuggestion(chip: Chip) {\n  // TODO: add selected suggestion chip\n}\n\nfunction onKeyDown(event: KeyboardEvent) {\n  // TODO:\n  // ArrowDown/ArrowUp => move active suggestion (wrap around)\n  // Enter => select active suggestion if present, otherwise add custom\n  // comma => add custom\n  // Backspace on empty query => remove last chip\n  // Escape => close suggestions\n}\n\nwatch(query, () => {\n  activeIndex.value = -1;\n  // TODO: open dropdown only when query has text and suggestions exist\n});\n\nfunction onFocus() {\n  // TODO: open dropdown when query has text and suggestions exist\n}\n\nfunction optionId(index: number): string {\n  return 'invite-option-' + String(index);\n}\n\nfunction normalize(value: string): string {\n  return value.trim().toLowerCase();\n}\n\nfunction onDocMouseDown(event: MouseEvent) {\n  const target = event.target as Node | null;\n  if (!target || !rootRef.value) return;\n  if (!rootRef.value.contains(target)) {\n    isOpen.value = false;\n    activeIndex.value = -1;\n  }\n}\n\nonMounted(() => {\n  document.addEventListener('mousedown', onDocMouseDown);\n});\n\nonBeforeUnmount(() => {\n  document.removeEventListener('mousedown', onDocMouseDown);\n});\n</script>\n",
    "src/App.css": ":root {\n  color-scheme: dark;\n}\n\nhtml,body {\n  margin: 0;\n  height: 100%;\n  background: #0a0a0a;\n}\n\nbody {\n  font-family: system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;\n}\n\n.page {\n  min-height: 100vh;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n  background: #0a0a0a;\n  color: #e5e7eb;\n}\n\n.card {\n  width: 100%;\n  max-width: 640px;\n  background: #0b1020;\n  border: 1px solid #1f2937;\n  border-radius: 14px;\n  padding: 18px;\n  display: grid;\n  gap: 12px;\n}\n\nh1 {\n  margin: 0;\n  font-size: 20px;\n}\n\n.subtitle {\n  margin: 0;\n  color: #9ca3af;\n  font-size: 14px;\n  line-height: 1.45;\n}\n\n.combobox {\n  position: relative;\n}\n\n.chip-input {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 8px;\n  padding: 10px;\n  border-radius: 12px;\n  border: 1px solid #374151;\n  background: #0a0f1e;\n}\n\n.chip-input:focus-within {\n  border-color: #a3e635;\n  box-shadow: 0 0 0 2px rgba(163,230,53,.15);\n}\n\n.chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  padding: 4px 10px;\n  border-radius: 999px;\n  background: #172036;\n  border: 1px solid #2c3c62;\n  font-size: 13px;\n}\n\n.chip-remove {\n  border: none;\n  background: transparent;\n  color: #9ca3af;\n  cursor: pointer;\n  font-size: 16px;\n  line-height: 1;\n  padding: 0;\n}\n\n.chip-remove:hover {\n  color: #e5e7eb;\n}\n\n.chip-input input {\n  flex: 1;\n  min-width: 180px;\n  border: none;\n  outline: none;\n  background: transparent;\n  color: #e5e7eb;\n  font-size: 14px;\n  padding: 4px 0;\n}\n\n.chip-input input::placeholder {\n  color: #6b7280;\n}\n\n.suggestions {\n  position: absolute;\n  left: 0;\n  right: 0;\n  z-index: 10;\n  margin-top: 8px;\n  max-height: 260px;\n  overflow: auto;\n  border-radius: 12px;\n  border: 1px solid #1f2937;\n  background: #0a0f1e;\n  padding: 0;\n  list-style: none;\n}\n\n.suggestion {\n  display: grid;\n  gap: 2px;\n  padding: 10px 12px;\n  border-bottom: 1px solid rgba(31,41,55,.5);\n  cursor: pointer;\n}\n\n.suggestion:last-child {\n  border-bottom: none;\n}\n\n.suggestion span {\n  font-size: 12px;\n  color: #9ca3af;\n}\n\n.suggestion.active {\n  background: rgba(163,230,53,.12);\n}\n\n.hint {\n  margin: 0;\n  color: #9ca3af;\n  font-size: 12px;\n}\n",
    "tsconfig.json": "{\n  \"compilerOptions\": {\n    \"target\": \"ES2020\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"Node\",\n    \"strict\": true,\n    \"allowJs\": true\n  }\n}\n"
  }
}
