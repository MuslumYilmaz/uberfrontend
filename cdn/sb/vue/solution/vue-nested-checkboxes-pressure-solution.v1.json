    "src/App.vue": "<template>\n  <main class=\"main\">\n    <section class=\"section\">\n      <h1>Nested Checkboxes</h1>\n\n      <div class=\"panel\">\n        <label\n          v-for=\"row in ROWS\"\n          :key=\"row.node.id\"\n          :class=\"row.depth === 0 ? 'parent' : 'child'\"\n          :style=\"{ marginLeft: row.depth * 24 + 'px' }\"\n        >\n          <input\n            type=\"checkbox\"\n            :data-id=\"row.node.id\"\n            :checked=\"stateOf(row.node).checked\"\n            :indeterminate=\"stateOf(row.node).indeterminate\"\n            :disabled=\"!!row.node.locked\"\n            @change=\"toggle(row.node)\"\n          />\n          <span>{{ row.node.label }}</span>\n        </label>\n\n        <p class=\"selection-summary\" aria-live=\"polite\">\n          {{ selectedIds.length }} of {{ UNLOCKED_LEAVES.length }} selected\n        </p>\n        <p class=\"selected-ids\">{{ selectedIds.join(', ') }}</p>\n        <button type=\"button\" class=\"reset-selection\" @click=\"reset\">Reset selection</button>\n      </div>\n    </section>\n  </main>\n</template>\n\n<script setup lang=\"ts\">\nimport { computed, ref } from 'vue';\n\ntype TreeNode = {\n  id: string;\n  label: string;\n  locked?: boolean;\n  children?: TreeNode[];\n};\n\nconst TREE: TreeNode = {\n  id: 'parent',\n  label: 'Parent',\n  children: [\n    {\n      id: 'child-1',\n      label: 'Child 1',\n      children: [\n        { id: 'child-1-1', label: 'Child 1.1' },\n        { id: 'child-1-2', label: 'Child 1.2' }\n      ]\n    },\n    { id: 'child-2', label: 'Child 2' },\n    { id: 'child-3', label: 'Child 3' },\n    { id: 'child-4', label: 'Child 4', locked: true },\n    { id: 'child-5', label: 'Child 5', locked: true }\n  ]\n};\n\n// Only items with no children store a value. Every other checkbox is calculated from them.\nconst INITIAL_SELECTED: Record<string, boolean> = { 'child-5': true };\n\nfunction leavesOf(node: TreeNode): TreeNode[] {\n  return node.children ? node.children.flatMap((child) => leavesOf(child)) : [node];\n}\n\nconst unlockedLeavesOf = (node: TreeNode) => leavesOf(node).filter((leaf) => !leaf.locked);\n\n// One recursive helper turns the tree into rows, so every level is drawn the same way.\nfunction rowsOf(node: TreeNode, depth = 0): Array<{ node: TreeNode; depth: number }> {\n  const below = (node.children ?? []).flatMap((child) => rowsOf(child, depth + 1));\n  return [{ node, depth }, ...below];\n}\n\nconst ROWS = rowsOf(TREE);\nconst UNLOCKED_LEAVES = unlockedLeavesOf(TREE);\n\nconst selected = ref(INITIAL_SELECTED);\n\n// Walking the tree keeps this order, whatever order the clicks came in.\nconst selectedIds = computed(() =>\n  UNLOCKED_LEAVES.filter((leaf) => selected.value[leaf.id]).map((leaf) => leaf.id)\n);\n\nfunction stateOf(node: TreeNode) {\n  if (!node.children) {\n    return { checked: !!selected.value[node.id], indeterminate: false };\n  }\n  // Locked items do not count, or the parent could never reach \"all checked\".\n  const leaves = unlockedLeavesOf(node);\n  const selectedCount = leaves.filter((leaf) => selected.value[leaf.id]).length;\n  return {\n    checked: selectedCount > 0 && selectedCount === leaves.length,\n    indeterminate: selectedCount > 0 && selectedCount < leaves.length\n  };\n}\n\nfunction toggle(node: TreeNode) {\n  const value = !stateOf(node).checked;\n  const next = { ...selected.value };\n  for (const leaf of unlockedLeavesOf(node)) next[leaf.id] = value;\n  selected.value = next;\n}\n\nfunction reset() {\n  selected.value = INITIAL_SELECTED;\n}\n</script>\n",
    "src/App.css": ":root {\n  color-scheme: dark;\n}\n\nhtml, body {\n  margin: 0;\n  height: 100%;\n  background: #0a0a0a;\n  font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;\n}\n\n.main {\n  min-height: 100vh;\n  background: #0a0a0a;\n  color: #e5e7eb;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n}\n\n.section {\n  width: 100%;\n  max-width: 420px;\n  display: grid;\n  gap: 16px;\n}\n\nh1 {\n  margin: 0;\n  font-size: 20px;\n  font-weight: 700;\n}\n\n.panel {\n  background: #0b1020;\n  border: 1px solid #1f2937;\n  border-radius: 12px;\n  padding: 16px;\n  display: grid;\n  gap: 12px;\n}\n\n.parent {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 16px;\n  font-weight: 600;\n}\n\n.children {\n  display: grid;\n  gap: 6px;\n  margin-left: 24px;\n}\n\n.child {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 14px;\n}\n\n.child input[type=checkbox], .parent input[type=checkbox] {\n  width: 16px;\n  height: 16px;\n}\n\ninput:disabled + span {\n  opacity: 0.6;\n}\n\n.selection-summary {\n  margin: 4px 0 0;\n  font-size: 14px;\n  font-weight: 600;\n}\n\n.selected-ids {\n  margin: 0;\n  min-height: 20px;\n  font-size: 13px;\n  color: #9ca3af;\n  overflow-wrap: anywhere;\n}\n\n.reset-selection {\n  justify-self: start;\n  border-radius: 999px;\n  border: 1px solid #374151;\n  background: transparent;\n  color: #e5e7eb;\n  padding: 6px 14px;\n  font-size: 13px;\n  font-weight: 600;\n  cursor: pointer;\n}\n"
  }
}
