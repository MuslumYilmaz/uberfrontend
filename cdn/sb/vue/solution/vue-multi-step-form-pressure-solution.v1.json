{
  "dependencies": {
    "vue": "3.x"
  },
  "openFile": "/src/App.vue",
  "files": {
    "src/App.vue": "<template>\n  <main class=\"app\">\n    <section class=\"card\">\n      <header class=\"header\">\n        <h1>Multi-step Signup</h1>\n        <p class=\"subtitle\" aria-live=\"polite\">Step {{ stepIndex + 1 }} of {{ steps.length }}</p>\n      </header>\n\n      <section class=\"steps\">\n        <div class=\"step\">\n          <h2 ref=\"titleRef\" class=\"step-title\" tabindex=\"-1\">{{ TITLES[stepId] }}</h2>\n\n          <div v-if=\"stepId === 'basic'\" class=\"step-fields\">\n            <label class=\"field\">\n              <span>Name</span>\n              <input\n                id=\"name\"\n                type=\"text\"\n                placeholder=\"Jane Doe\"\n                v-model=\"form.basic.name\"\n                :aria-invalid=\"showError('name') ? 'true' : null\"\n              />\n              <small v-if=\"showError('name')\" class=\"error\">Name is required.</small>\n            </label>\n\n            <label class=\"field\">\n              <span>Email</span>\n              <input\n                id=\"email\"\n                type=\"email\"\n                placeholder=\"jane@example.com\"\n                v-model=\"form.basic.email\"\n                :aria-invalid=\"showError('email') ? 'true' : null\"\n              />\n              <small v-if=\"showError('email')\" class=\"error\">Please enter a valid email.</small>\n            </label>\n\n            <label class=\"company-toggle\">\n              <input class=\"is-company\" type=\"checkbox\" v-model=\"form.company.isCompany\" />\n              <span>I am signing up for a company</span>\n            </label>\n          </div>\n\n          <div v-else-if=\"stepId === 'address'\" class=\"step-fields\">\n            <label class=\"field\">\n              <span>Street</span>\n              <input\n                id=\"street\"\n                type=\"text\"\n                placeholder=\"123 Main St\"\n                v-model=\"form.address.street\"\n                :aria-invalid=\"showError('street') ? 'true' : null\"\n              />\n              <small v-if=\"showError('street')\" class=\"error\">Street is required.</small>\n            </label>\n\n            <label class=\"field\">\n              <span>City</span>\n              <input\n                id=\"city\"\n                type=\"text\"\n                placeholder=\"Istanbul\"\n                v-model=\"form.address.city\"\n                :aria-invalid=\"showError('city') ? 'true' : null\"\n              />\n              <small v-if=\"showError('city')\" class=\"error\">City is required.</small>\n            </label>\n\n            <label class=\"field\">\n              <span>Country</span>\n              <input\n                id=\"country\"\n                type=\"text\"\n                placeholder=\"Türkiye\"\n                v-model=\"form.address.country\"\n                :aria-invalid=\"showError('country') ? 'true' : null\"\n              />\n              <small v-if=\"showError('country')\" class=\"error\">Country is required.</small>\n            </label>\n\n            <label class=\"field\">\n              <span>Postal code (optional)</span>\n              <input id=\"postal-code\" type=\"text\" placeholder=\"34000\" v-model=\"form.address.postalCode\" />\n            </label>\n          </div>\n\n          <div v-else-if=\"stepId === 'company'\" class=\"step-fields\">\n            <label class=\"field\">\n              <span>Company name</span>\n              <input\n                id=\"company-name\"\n                type=\"text\"\n                placeholder=\"Acme\"\n                v-model=\"form.company.name\"\n                :aria-invalid=\"showError('company-name') ? 'true' : null\"\n              />\n              <small v-if=\"showError('company-name')\" class=\"error\">Company name is required.</small>\n            </label>\n          </div>\n\n          <div v-else class=\"summary\">\n            <div class=\"summary-heading\">\n              <h3>Basic info</h3>\n              <button v-if=\"!submitted\" type=\"button\" class=\"edit-basic\" aria-label=\"Edit basic info\" @click=\"edit('basic')\">Edit</button>\n            </div>\n            <p><strong>Name:</strong> {{ form.basic.name }}</p>\n            <p><strong>Email:</strong> {{ form.basic.email }}</p>\n\n            <div class=\"summary-heading\">\n              <h3>Address</h3>\n              <button v-if=\"!submitted\" type=\"button\" class=\"edit-address\" aria-label=\"Edit address\" @click=\"edit('address')\">Edit</button>\n            </div>\n            <p><strong>Street:</strong> {{ form.address.street }}</p>\n            <p><strong>City:</strong> {{ form.address.city }}</p>\n            <p><strong>Country:</strong> {{ form.address.country }}</p>\n            <p><strong>Postal code:</strong> {{ form.address.postalCode || '—' }}</p>\n\n            <h3 v-if=\"form.company.isCompany\">Company</h3>\n            <p v-if=\"form.company.isCompany\"><strong>Company name:</strong> {{ form.company.name }}</p>\n          </div>\n        </div>\n      </section>\n\n      <div v-if=\"submitted\" class=\"done\">\n        <p class=\"success\" role=\"status\">Signup complete for {{ form.basic.name.trim() }}.</p>\n        <button ref=\"restartRef\" type=\"button\" class=\"restart\" @click=\"restart\">Start over</button>\n      </div>\n\n      <footer v-else class=\"actions\">\n        <button type=\"button\" class=\"ghost\" @click=\"prev\" :disabled=\"stepIndex === 0\">Back</button>\n        <button v-if=\"stepId !== 'summary'\" type=\"button\" @click=\"next\">{{ editing ? 'Save' : 'Next' }}</button>\n        <button v-else type=\"button\" class=\"primary\" @click=\"submit\">Submit</button>\n      </footer>\n    </section>\n  </main>\n</template>\n\n<script setup lang=\"ts\">\nimport { computed, nextTick, reactive, ref, watch } from 'vue';\n\ntype StepId = 'basic' | 'address' | 'company' | 'summary';\n\nconst TITLES: Record<StepId, string> = {\n  basic: 'Basic info',\n  address: 'Address',\n  company: 'Company',\n  summary: 'Summary'\n};\n\n// The required input ids on each step, in the order they appear.\nconst STEP_FIELDS: Record<StepId, string[]> = {\n  basic: ['name', 'email'],\n  address: ['street', 'city', 'country'],\n  company: ['company-name'],\n  summary: []\n};\n\nconst emptyForm = () => ({\n  basic: { name: '', email: '' },\n  address: { street: '', city: '', country: '', postalCode: '' },\n  company: { isCompany: false, name: '' }\n});\n\nconst isBlank = (value: string) => value.trim().length === 0;\n\n// One form object, so moving between steps can never lose a value.\nconst form = reactive(emptyForm());\nconst stepId = ref<StepId>('basic');\nconst showErrors = ref(false);\nconst editing = ref(false);\nconst submitted = ref(false);\n\nconst titleRef = ref<HTMLElement | null>(null);\nconst restartRef = ref<HTMLElement | null>(null);\n\n// Everything about the steps reads this list, so the company step needs no special cases.\nconst steps = computed<StepId[]>(() =>\n  form.company.isCompany\n    ? ['basic', 'address', 'company', 'summary']\n    : ['basic', 'address', 'summary']\n);\nconst stepIndex = computed(() => steps.value.indexOf(stepId.value));\n\nconst errors = computed<Record<string, boolean>>(() => ({\n  name: isBlank(form.basic.name),\n  email: !/\\S+@\\S+\\.\\S+/.test(form.basic.email),\n  street: isBlank(form.address.street),\n  city: isBlank(form.address.city),\n  country: isBlank(form.address.country),\n  'company-name': isBlank(form.company.name)\n}));\n\nconst showError = (id: string) => showErrors.value && errors.value[id];\n\nwatch(stepId, async () => {\n  await nextTick();\n  titleRef.value?.focus();\n});\n\nfunction next() {\n  const invalid = STEP_FIELDS[stepId.value].filter((id) => errors.value[id]);\n  if (invalid.length > 0) {\n    showErrors.value = true;\n    document.getElementById(invalid[0])?.focus();\n    return;\n  }\n\n  showErrors.value = false;\n  if (!editing.value) {\n    stepId.value = steps.value[stepIndex.value + 1];\n    return;\n  }\n\n  // Turning on the company step while editing adds a field nobody has filled in yet.\n  const unfinished = steps.value.find((step) => STEP_FIELDS[step].some((id) => errors.value[id]));\n  if (!unfinished) editing.value = false;\n  stepId.value = unfinished ?? 'summary';\n}\n\nfunction prev() {\n  showErrors.value = false;\n  editing.value = false;\n  stepId.value = steps.value[stepIndex.value - 1];\n}\n\nfunction edit(step: StepId) {\n  showErrors.value = false;\n  editing.value = true;\n  stepId.value = step;\n}\n\nasync function submit() {\n  submitted.value = true;\n  await nextTick();\n  restartRef.value?.focus();\n}\n\nfunction restart() {\n  Object.assign(form, emptyForm());\n  stepId.value = 'basic';\n  showErrors.value = false;\n  editing.value = false;\n  submitted.value = false;\n}\n</script>\n",
    "src/App.css": ":root {\n  color-scheme: dark;\n}\n\nhtml, body {\n  margin: 0;\n  height: 100%;\n  background: #020617;\n  font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;\n}\n\n.app {\n  min-height: 100vh;\n  display: grid;\n  place-items: center;\n  background: #020617;\n  color: #e5e7eb;\n  padding: 24px;\n}\n\n.card {\n  width: 100%;\n  max-width: 520px;\n  background: #020617;\n  border-radius: 16px;\n  border: 1px solid #1f2937;\n  padding: 20px 20px 16px;\n  display: grid;\n  gap: 16px;\n}\n\n.header h1 {\n  margin: 0;\n  font-size: 20px;\n  font-weight: 700;\n}\n\n.subtitle {\n  margin: 4px 0 0;\n  font-size: 13px;\n  color: #9ca3af;\n}\n\n.steps {\n  min-height: 260px;\n}\n\n.step {\n  display: grid;\n  gap: 12px;\n}\n\n.step-title {\n  margin: 0 0 4px;\n  font-size: 16px;\n  font-weight: 600;\n}\n\n.field {\n  display: grid;\n  gap: 4px;\n  font-size: 13px;\n}\n\n.field span {\n  color: #e5e7eb;\n}\n\n.field input {\n  border-radius: 10px;\n  border: 1px solid #374151;\n  background: #020617;\n  padding: 8px 10px;\n  color: #e5e7eb;\n  font-size: 14px;\n}\n\n.field input:focus {\n  outline: none;\n  border-color: #a3e635;\n}\n\n.error {\n  font-size: 11px;\n  color: #f97316;\n}\n\n.summary {\n  display: grid;\n  gap: 4px;\n  font-size: 14px;\n}\n\n.summary h3 {\n  margin: 8px 0 2px;\n  font-size: 14px;\n  font-weight: 600;\n  color: #e5e7eb;\n}\n\n.actions {\n  display: flex;\n  justify-content: space-between;\n  gap: 8px;\n  margin-top: 4px;\n}\n\n.actions button {\n  border-radius: 999px;\n  border: 1px solid #374151;\n  background: #020617;\n  color: #e5e7eb;\n  padding: 8px 16px;\n  font-size: 14px;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n.actions button.primary {\n  background: #a3e635;\n  color: #020617;\n  border-color: #a3e635;\n}\n\n.actions button[disabled] {\n  opacity: .5;\n  cursor: not-allowed;\n}\n\n.actions button.ghost {\n  background: transparent;\n}\n\n.success {\n  margin: -4px 0 0;\n  font-size: 13px;\n  color: #a3e635;\n  font-weight: 700;\n}\n\n.step-title:focus {\n  outline: none;\n}\n\n.step-fields {\n  display: grid;\n  gap: 12px;\n}\n\n.field input[aria-invalid='true'] {\n  border-color: #f97316;\n}\n\n.company-toggle {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 13px;\n}\n\n.summary p {\n  margin: 0;\n  overflow-wrap: anywhere;\n}\n\n.summary-heading {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n}\n\n.edit-basic,\n.edit-address,\n.restart {\n  border-radius: 999px;\n  border: 1px solid #374151;\n  background: transparent;\n  color: #e5e7eb;\n  padding: 4px 12px;\n  font-size: 13px;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n.done {\n  display: grid;\n  gap: 12px;\n  justify-items: start;\n}\n"
  }
}
