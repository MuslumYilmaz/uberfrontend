{
  "dependencies": {
    "vue": "3.x"
  },
  "openFile": "/src/App.vue",
  "files": {
    "src/App.vue": "<template>\n  <main class=\"page\">\n    <section class=\"card\">\n      <h1 class=\"title\">Transfer List</h1>\n      <p class=\"subtitle\">Select items and move them between lists.</p>\n\n      <div class=\"layout\">\n        <section class=\"listCard\">\n          <div class=\"listHeader\">\n            <div ref=\"topTitle\" class=\"listTitle\" tabindex=\"-1\">Top</div>\n            <label class=\"selectAll\">\n              <input\n                class=\"select-all\"\n                type=\"checkbox\"\n                :checked=\"visibleTop.length > 0 && selectedTop.length === visibleTop.length\"\n                :indeterminate=\"selectedTop.length > 0 && selectedTop.length < visibleTop.length\"\n                :disabled=\"visibleTop.length === 0\"\n                @change=\"toggleAllTop\"\n              />\n              <span>Select all</span>\n            </label>\n          </div>\n\n          <input\n            class=\"list-search\"\n            type=\"text\"\n            placeholder=\"Search\"\n            aria-label=\"Search Top\"\n            v-model=\"topSearch\"\n          />\n\n          <p class=\"selection-count\">{{ selectedTop.length }} of {{ visibleTop.length }} selected</p>\n\n          <ul class=\"list\" role=\"list\">\n            <li v-for=\"item in visibleTop\" :key=\"item.id\" class=\"row\">\n              <label class=\"rowLabel\">\n                <input\n                  type=\"checkbox\"\n                  :checked=\"topSelected.has(item.id)\"\n                  @change=\"onTopChange(item.id, $event)\"\n                />\n                <span>{{ item.label }}</span>\n              </label>\n            </li>\n            <li v-if=\"visibleTop.length === 0\" class=\"empty\">{{ topItems.length === 0 ? 'Empty' : 'No matches' }}</li>\n          </ul>\n        </section>\n\n        <section class=\"controls\">\n          <button class=\"btn\" @click=\"moveDown\" :disabled=\"!canMoveDown\" aria-label=\"move down\">\n            ↓\n          </button>\n          <button class=\"btn\" @click=\"moveUp\" :disabled=\"!canMoveUp\" aria-label=\"move up\">\n            ↑\n          </button>\n        </section>\n\n        <section class=\"listCard\">\n          <div class=\"listHeader\">\n            <div ref=\"bottomTitle\" class=\"listTitle\" tabindex=\"-1\">Bottom</div>\n            <label class=\"selectAll\">\n              <input\n                class=\"select-all\"\n                type=\"checkbox\"\n                :checked=\"visibleBottom.length > 0 && selectedBottom.length === visibleBottom.length\"\n                :indeterminate=\"selectedBottom.length > 0 && selectedBottom.length < visibleBottom.length\"\n                :disabled=\"visibleBottom.length === 0\"\n                @change=\"toggleAllBottom\"\n              />\n              <span>Select all</span>\n            </label>\n          </div>\n\n          <input\n            class=\"list-search\"\n            type=\"text\"\n            placeholder=\"Search\"\n            aria-label=\"Search Bottom\"\n            v-model=\"bottomSearch\"\n          />\n\n          <p class=\"selection-count\">{{ selectedBottom.length }} of {{ visibleBottom.length }} selected</p>\n\n          <ul class=\"list\" role=\"list\">\n            <li v-for=\"item in visibleBottom\" :key=\"item.id\" class=\"row\">\n              <label class=\"rowLabel\">\n                <input\n                  type=\"checkbox\"\n                  :checked=\"bottomSelected.has(item.id)\"\n                  @change=\"onBottomChange(item.id, $event)\"\n                />\n                <span>{{ item.label }}</span>\n              </label>\n            </li>\n            <li v-if=\"visibleBottom.length === 0\" class=\"empty\">{{ bottomItems.length === 0 ? 'Empty' : 'No matches' }}</li>\n          </ul>\n        </section>\n      </div>\n\n      <div class=\"history\">\n        <button type=\"button\" class=\"undo-move\" @click=\"undo\" :disabled=\"!canUndo\">Undo</button>\n        <p class=\"transfer-status\" aria-live=\"polite\">{{ status }}</p>\n      </div>\n    </section>\n  </main>\n</template>\n\n<script setup lang=\"ts\">\nimport { computed, ref } from 'vue';\n\ntype Item = { id: string; label: string };\ntype Snapshot = { top: Item[]; bottom: Item[] };\n\nconst INITIAL_TOP: Item[] = [\n  { id: 'a', label: 'Alpha' },\n  { id: 'b', label: 'Beta' },\n  { id: 'c', label: 'Gamma' },\n  { id: 'd', label: 'Delta' },\n  { id: 'e', label: 'Epsilon' }\n];\n\nconst INITIAL_BOTTOM: Item[] = [\n  { id: 'x', label: 'Xenon' },\n  { id: 'y', label: 'Yttrium' },\n  { id: 'z', label: 'Zinc' }\n];\n\nconst topItems = ref<Item[]>(INITIAL_TOP);\nconst bottomItems = ref<Item[]>(INITIAL_BOTTOM);\nconst topSelected = ref<Set<string>>(new Set<string>());\nconst bottomSelected = ref<Set<string>>(new Set<string>());\nconst topSearch = ref('');\nconst bottomSearch = ref('');\nconst status = ref('');\n// Snapshots, because moving items back would not restore their order.\nconst history = ref<Snapshot[]>([]);\nconst topTitle = ref<HTMLElement | null>(null);\nconst bottomTitle = ref<HTMLElement | null>(null);\n\nconst rowsMatching = (items: Item[], search: string) => {\n  const term = search.trim().toLowerCase();\n  return items.filter((item) => item.label.toLowerCase().includes(term));\n};\n\nconst withSelection = (selected: Set<string>, ids: string[], checked: boolean) => {\n  const next = new Set(selected);\n  for (const id of ids) {\n    if (checked) next.add(id);\n    else next.delete(id);\n  }\n  return next;\n};\n\n// Only the rows on screen count for select all, the count and the move buttons.\nconst visibleTop = computed(() => rowsMatching(topItems.value, topSearch.value));\nconst visibleBottom = computed(() => rowsMatching(bottomItems.value, bottomSearch.value));\nconst selectedTop = computed(() => visibleTop.value.filter((item) => topSelected.value.has(item.id)));\nconst selectedBottom = computed(() => visibleBottom.value.filter((item) => bottomSelected.value.has(item.id)));\n\nconst canMoveDown = computed(() => selectedTop.value.length > 0);\nconst canMoveUp = computed(() => selectedBottom.value.length > 0);\nconst canUndo = computed(() => history.value.length > 0);\n\nconst onTopChange = (id: string, e: Event) => {\n  const checked = (e.currentTarget as HTMLInputElement | null)?.checked ?? false;\n  topSelected.value = withSelection(topSelected.value, [id], checked);\n};\n\nconst onBottomChange = (id: string, e: Event) => {\n  const checked = (e.currentTarget as HTMLInputElement | null)?.checked ?? false;\n  bottomSelected.value = withSelection(bottomSelected.value, [id], checked);\n};\n\nconst toggleAllTop = () => {\n  const select = selectedTop.value.length < visibleTop.value.length;\n  topSelected.value = withSelection(topSelected.value, visibleTop.value.map((item) => item.id), select);\n};\n\nconst toggleAllBottom = () => {\n  const select = selectedBottom.value.length < visibleBottom.value.length;\n  bottomSelected.value = withSelection(bottomSelected.value, visibleBottom.value.map((item) => item.id), select);\n};\n\nconst remember = () => {\n  history.value = [...history.value, { top: topItems.value, bottom: bottomItems.value }];\n};\n\nconst announce = (count: number, title: string) => {\n  status.value = `${count} ${count === 1 ? 'item' : 'items'} moved to ${title}`;\n};\n\nconst moveDown = () => {\n  const moved = selectedTop.value;\n  if (moved.length === 0) return;\n  const ids = moved.map((item) => item.id);\n\n  remember();\n  topItems.value = topItems.value.filter((item) => !ids.includes(item.id));\n  bottomItems.value = [...bottomItems.value, ...moved];\n  topSelected.value = withSelection(topSelected.value, ids, false);\n  announce(moved.length, 'Bottom');\n  // The pressed button may turn off, so focus goes to where the items went.\n  bottomTitle.value?.focus();\n};\n\nconst moveUp = () => {\n  const moved = selectedBottom.value;\n  if (moved.length === 0) return;\n  const ids = moved.map((item) => item.id);\n\n  remember();\n  bottomItems.value = bottomItems.value.filter((item) => !ids.includes(item.id));\n  topItems.value = [...topItems.value, ...moved];\n  bottomSelected.value = withSelection(bottomSelected.value, ids, false);\n  announce(moved.length, 'Top');\n  topTitle.value?.focus();\n};\n\nconst undo = () => {\n  const snapshot = history.value[history.value.length - 1];\n  if (!snapshot) return;\n  history.value = history.value.slice(0, -1);\n  topItems.value = snapshot.top;\n  bottomItems.value = snapshot.bottom;\n  topSelected.value = new Set<string>();\n  bottomSelected.value = new Set<string>();\n  status.value = 'Move undone';\n  // The last undo turns this button off.\n  if (history.value.length === 0) topTitle.value?.focus();\n};\n</script>\n",
    "src/App.css": ":root {\n  color-scheme: dark;\n}\n\nhtml,body {\n  margin: 0;\n  height: 100%;\n  background: #0a0a0a;\n}\n\nbody {\n  font-family: system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;\n}\n\n.page {\n  min-height: 100vh;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n  background: #0a0a0a;\n  color: #e5e7eb;\n}\n\n.card {\n  width: 100%;\n  max-width: 780px;\n  background: #0b1020;\n  border: 1px solid #1f2937;\n  border-radius: 14px;\n  padding: 18px;\n  display: grid;\n  gap: 14px;\n}\n\n.title {\n  margin: 0;\n  font-size: 18px;\n  font-weight: 800;\n}\n\n.subtitle {\n  margin: 0;\n  color: #9ca3af;\n  font-size: 12px;\n}\n\n.layout {\n  display: grid;\n  grid-template-columns: 1fr auto 1fr;\n  gap: 14px;\n  align-items: start;\n}\n\n.listCard {\n  background: #0a0f1e;\n  border: 1px solid #1f2937;\n  border-radius: 12px;\n  padding: 12px;\n}\n\n.listTitle {\n  font-size: 12px;\n  color: #9ca3af;\n  margin-bottom: 8px;\n}\n\n.list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: grid;\n  gap: 6px;\n}\n\n.row {\n  padding: 8px 10px;\n  border: 1px solid rgba(31,41,55,.5);\n  border-radius: 10px;\n}\n\n.rowLabel {\n  display: flex;\n  gap: 10px;\n  align-items: center;\n  cursor: pointer;\n}\n\n.rowLabel input {\n  accent-color: #a3e635;\n}\n\n.controls {\n  display: grid;\n  gap: 10px;\n  place-items: center;\n  padding-top: 22px;\n}\n\n.btn {\n  width: 44px;\n  height: 44px;\n  border-radius: 12px;\n  border: 1px solid #374151;\n  background: #0a0f1e;\n  color: #e5e7eb;\n  font-weight: 900;\n  cursor: pointer;\n}\n\n.btn:disabled {\n  opacity: .5;\n  cursor: not-allowed;\n}\n\n.empty {\n  padding: 8px 10px;\n  color: #9ca3af;\n}\n\n.hint {\n  margin: 0;\n  color: #9ca3af;\n  font-size: 12px;\n}\n\n@media (max-width:720px) {\n  .layout {\n    grid-template-columns: 1fr;\n  }\n\n  .controls {\n    grid-template-columns: 1fr 1fr;\n    justify-content: center;\n    padding-top: 0;\n  }\n}\n\n.listCard {\n  min-width: 0;\n}\n\n.listHeader {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  margin-bottom: 8px;\n}\n\n.listHeader .listTitle {\n  margin-bottom: 0;\n}\n\n.listTitle:focus {\n  outline: none;\n  color: #e5e7eb;\n}\n\n.selectAll {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 12px;\n  color: #9ca3af;\n  cursor: pointer;\n}\n\n.selectAll input {\n  accent-color: #a3e635;\n}\n\n.list-search {\n  box-sizing: border-box;\n  width: 100%;\n  padding: 8px 10px;\n  border-radius: 10px;\n  border: 1px solid #374151;\n  background: #0b1020;\n  color: #e5e7eb;\n  font-size: 13px;\n}\n\n.selection-count {\n  margin: 8px 0;\n  font-size: 12px;\n  color: #9ca3af;\n}\n\n.history {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 12px;\n}\n\n.undo-move {\n  border-radius: 10px;\n  border: 1px solid #374151;\n  background: #0a0f1e;\n  color: #e5e7eb;\n  padding: 8px 14px;\n  font-weight: 700;\n  cursor: pointer;\n}\n\n.undo-move:disabled {\n  opacity: .5;\n  cursor: not-allowed;\n}\n\n.transfer-status {\n  margin: 0;\n  min-height: 18px;\n  font-size: 13px;\n  color: #a3e635;\n}\n"
  }
}
