  "openFile": "/src/App.vue",
  "files": {
    "package.json": "{\n  \"name\": \"vue-dynamic-counter-buttons-pressure-solution\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"dependencies\": {\n    \"vue\": \"3.x\"\n  },\n  \"scripts\": {\n    \"serve\": \"vue-cli-service serve\"\n  }\n}\n",
    "public/index.html": "<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Vue SDK • Dynamic Counter Buttons (pressure solution)</title></head><body><div id='app'></div></body></html>",
    "src/main.ts": "import { createApp } from 'vue';\nimport App from './App.vue';\nimport './App.css';\n\ncreateApp(App).mount('#app');\n",
    "src/App.vue": "<template>\n  <main class='page'>\n    <section class='card'>\n      <h1>Dynamic Counter Buttons</h1>\n      <p class='subtitle'>\n        Grow independent counters, remove them by stable identity, and keep keyboard focus predictable.\n      </p>\n\n      <div class='toolbar'>\n        <label class='limit-control' for='counter-limit'>\n          Counter limit\n          <input\n            id='counter-limit'\n            type='number'\n            min='1'\n            max='10'\n            :value=\"limit\"\n            @input=\"onLimitInput(String(($event.target && $event.target.value) || ''))\"\n          />\n        </label>\n        <button\n          id='reset-counters'\n          class='reset-button'\n          type='button'\n          :disabled=\"isInitial\"\n          @click=\"resetCounters\"\n        >\n          Reset\n        </button>\n      </div>\n\n      <p id='counter-status' class='status' role='status' aria-live='polite'>\n        {{ statusText }}\n      </p>\n\n      <div\n        class='counter-list'\n        role='list'\n        aria-label='Dynamic counter buttons'\n        aria-describedby='counter-status'\n      >\n        <div\n          v-for=\"counterView in counters\"\n          :key=\"counterView.id\"\n          :id=\"counterRowId(counterView.id)\"\n          class='counter-row'\n          role='listitem'\n          :data-counter-id=\"counterView.id\"\n        >\n          <button\n            :id=\"counterButtonId(counterView.id)\"\n            :ref=\"setCounterRef\"\n            class='counter-button'\n            type='button'\n            :aria-label=\"counterLabel(counterView)\"\n            :tabindex=\"focusId === counterView.id ? 0 : -1\"\n            @focus=\"onCounterFocus(counterView.id)\"\n            @keydown=\"onCounterKeydown($event, counterView.id)\"\n            @click=\"onClick(counterView.id)\"\n          >\n            Counter {{ counterView.id }}:\n            <span class='counter-value'>{{ counterView.count }}</span>\n          </button>\n          <button\n            :id=\"removeButtonId(counterView.id)\"\n            class='remove-button'\n            type='button'\n            :aria-label=\"removeCounterLabel(counterView.id)\"\n            :aria-controls=\"counterRowId(counterView.id)\"\n            :disabled=\"counters.length === 1\"\n            @click=\"removeCounter(counterView.id)\"\n          >\n            Remove\n          </button>\n        </div>\n      </div>\n    </section>\n  </main>\n</template>\n\n<script setup lang=\"ts\">\nimport { computed, nextTick, ref } from 'vue';\n\ntype CounterButton = { id: number; count: number };\ntype NavigationKey = 'ArrowUp' | 'ArrowDown' | 'Home' | 'End';\n\nconst MIN_LIMIT = 1;\nconst MAX_LIMIT = 10;\nconst DEFAULT_LIMIT = 5;\nconst NAVIGATION_KEYS: NavigationKey[] = ['ArrowUp', 'ArrowDown', 'Home', 'End'];\n\nconst counters = ref<CounterButton[]>([{ id: 1, count: 0 }]);\nconst limit = ref(DEFAULT_LIMIT);\nconst focusId = ref(1);\nlet nextId = 2;\nconst counterRefs = new Map<number, HTMLButtonElement>();\n\nconst combinedValue = computed(() => (\n  counters.value.reduce((sum, counterState) => sum + counterState.count, 0)\n));\n\nconst statusText = computed(() => (\n  'Counters: ' + counters.value.length + ' of ' + limit.value\n    + '. Combined value: ' + combinedValue.value + '.'\n));\n\nconst isInitial = computed(() => (\n  limit.value === DEFAULT_LIMIT\n    && counters.value.length === 1\n    && counters.value[0].id === 1\n    && counters.value[0].count === 0\n));\n\nconst counterRowId = (id: number): string => 'counter-row-' + id;\nconst counterButtonId = (id: number): string => 'counter-button-' + id;\nconst removeButtonId = (id: number): string => 'remove-counter-' + id;\nconst counterLabel = (counterState: CounterButton): string => (\n  'Counter ' + counterState.id + ', value ' + counterState.count\n);\nconst removeCounterLabel = (id: number): string => 'Remove counter ' + id;\n\nconst setCounterRef = (element: Element | null) => {\n  if (!(element instanceof HTMLButtonElement)) return;\n  const parsedIdValue = Number(element.id.replace('counter-button-', ''));\n  if (Number.isFinite(parsedIdValue)) counterRefs.set(parsedIdValue, element);\n};\n\nconst onCounterFocus = (id: number) => {\n  focusId.value = id;\n};\n\nconst onClick = (id: number) => {\n  focusId.value = id;\n  const updatedCounters = counters.value.map((counterState) => (\n    counterState.id === id\n      ? { ...counterState, count: counterState.count + 1 }\n      : counterState\n  ));\n\n  if (counters.value.length < limit.value) {\n    updatedCounters.push({ id: nextId, count: 0 });\n    nextId += 1;\n  }\n\n  counters.value = updatedCounters;\n};\n\nconst removeCounter = (id: number) => {\n  if (counters.value.length === 1) return;\n  const removalIndexValue = counters.value.findIndex((counterState) => counterState.id === id);\n  if (removalIndexValue < 0) return;\n\n  const survivorList = counters.value.filter((counterState) => counterState.id !== id);\n  const destinationIndexValue = Math.min(removalIndexValue, survivorList.length - 1);\n  const destinationIdValue = survivorList[destinationIndexValue].id;\n\n  focusId.value = destinationIdValue;\n  counters.value = survivorList;\n  nextTick(() => counterRefs.get(destinationIdValue)?.focus());\n};\n\nconst onLimitInput = (raw: string) => {\n  const parsedLimitValue = Number(raw);\n  const nextLimitValue = Number.isFinite(parsedLimitValue)\n    ? Math.min(MAX_LIMIT, Math.max(MIN_LIMIT, Math.trunc(parsedLimitValue)))\n    : MIN_LIMIT;\n  const normalizedList = counters.value.slice(0, nextLimitValue);\n\n  limit.value = nextLimitValue;\n  counters.value = normalizedList;\n  if (!normalizedList.some((counterState) => counterState.id === focusId.value)) {\n    focusId.value = normalizedList[normalizedList.length - 1].id;\n  }\n};\n\nconst resetCounters = () => {\n  nextId = 2;\n  limit.value = DEFAULT_LIMIT;\n  counters.value = [{ id: 1, count: 0 }];\n  focusId.value = 1;\n};\n\nconst focusCounter = (id: number) => {\n  focusId.value = id;\n  counterRefs.get(id)?.focus();\n};\n\nconst onCounterKeydown = (event: KeyboardEvent, id: number) => {\n  const navigationKeyValue = event.key as NavigationKey;\n  if (!NAVIGATION_KEYS.includes(navigationKeyValue)) return;\n\n  event.preventDefault();\n  const currentIndexValue = counters.value.findIndex((counterState) => counterState.id === id);\n  if (currentIndexValue < 0) return;\n\n  let destinationIndexValue = currentIndexValue;\n  if (navigationKeyValue === 'ArrowUp') {\n    destinationIndexValue = (currentIndexValue + counters.value.length - 1) % counters.value.length;\n  } else if (navigationKeyValue === 'ArrowDown') {\n    destinationIndexValue = (currentIndexValue + 1) % counters.value.length;\n  } else if (navigationKeyValue === 'Home') {\n    destinationIndexValue = 0;\n  } else if (navigationKeyValue === 'End') {\n    destinationIndexValue = counters.value.length - 1;\n  }\n\n  focusCounter(counters.value[destinationIndexValue].id);\n};\n</script>\n",
    "src/App.css": ":root {\n  color-scheme: dark;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nhtml, body, #app {\n  margin: 0;\n  min-width: 0;\n  min-height: 100%;\n  background: #0a0a0a;\n}\n\nbody {\n  font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;\n}\n\nbutton, input {\n  font: inherit;\n}\n\n.page {\n  width: 100%;\n  min-height: 100vh;\n  padding: 24px;\n  display: grid;\n  place-items: center;\n  color: #e5e7eb;\n}\n\n.card {\n  width: 100%;\n  max-width: 620px;\n  min-width: 0;\n  padding: 18px;\n  display: grid;\n  gap: 14px;\n  border: 1px solid #1f2937;\n  border-radius: 16px;\n  background: #0b1020;\n}\n\nh1 {\n  margin: 0;\n  font-size: 21px;\n}\n\n.subtitle {\n  margin: 0;\n  color: #9ca3af;\n  font-size: 13px;\n  line-height: 1.5;\n}\n\n.toolbar {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: end;\n  gap: 10px;\n}\n\n.limit-control {\n  display: grid;\n  gap: 6px;\n  color: #cbd5e1;\n  font-size: 12px;\n}\n\n.limit-control input {\n  width: 110px;\n  padding: 9px 10px;\n  border: 1px solid #374151;\n  border-radius: 10px;\n  background: #0a0f1e;\n  color: #e5e7eb;\n}\n\n.reset-button,\n.remove-button,\n.counter-button {\n  border: 1px solid #374151;\n  border-radius: 10px;\n  color: #e5e7eb;\n}\n\n.reset-button,\n.remove-button {\n  padding: 9px 12px;\n  background: #111827;\n  cursor: pointer;\n}\n\nbutton:disabled {\n  cursor: not-allowed;\n  opacity: 0.48;\n}\n\n.status {\n  margin: 0;\n  padding: 9px 11px;\n  border: 1px solid #1f2937;\n  border-radius: 10px;\n  background: #0a0f1e;\n  color: #bfdbfe;\n  font-size: 13px;\n}\n\n.counter-list {\n  width: 100%;\n  min-width: 0;\n  display: grid;\n  gap: 9px;\n}\n\n.counter-row {\n  min-width: 0;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  gap: 9px;\n}\n\n.counter-button {\n  min-width: 0;\n  padding: 11px 14px;\n  overflow-wrap: anywhere;\n  background: #0a0f1e;\n  text-align: left;\n  cursor: pointer;\n}\n\n.counter-value {\n  color: #a3e635;\n  font-weight: 800;\n}\n\n.counter-button:hover,\n.remove-button:hover:not(:disabled),\n.reset-button:hover:not(:disabled) {\n  border-color: #60a5fa;\n}\n\n.counter-button:focus-visible,\n.remove-button:focus-visible,\n.reset-button:focus-visible,\n.limit-control input:focus-visible {\n  outline: 3px solid #a3e635;\n  outline-offset: 2px;\n}\n\n@media (max-width: 520px) {\n  .page {\n    padding: 12px;\n  }\n\n  .card {\n    padding: 14px;\n  }\n\n  .counter-row {\n    grid-template-columns: minmax(0, 1fr);\n  }\n}\n",
    "tsconfig.json": "{\n  \"compilerOptions\": {\n    \"target\": \"ES2020\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"Node\",\n    \"strict\": true,\n    \"allowJs\": true\n  }\n}\n"
  }
}
