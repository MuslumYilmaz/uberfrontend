{
  "dependencies": {
    "vue": "3.x"
  },
  "openFile": "/src/App.vue",
  "files": {
    "package.json": "{\n  \"name\": \"vue-tictactoe-pressure-solution\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"dependencies\": {\n    \"vue\": \"3.x\"\n  },\n  \"scripts\": {\n    \"serve\": \"vue-cli-service serve\"\n  }\n}\n",
    "public/index.html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Vue SDK • Tic-Tac-Toe (pressure solution)</title></head><body><div id=\"app\"></div></body></html>",
    "src/main.ts": "import { createApp } from 'vue';\nimport App from './App.vue';\nimport './App.css';\n\ncreateApp(App).mount('#app');\n",
    "src/App.vue": "<template>\n  <main class=\"page\">\n    <section class=\"card\">\n      <h1 class=\"title\">Tic-Tac-Toe</h1>\n      <p class=\"subtitle\">Two players take turns. First to 3 in a row wins.</p>\n\n      <div\n        id=\"game-status\"\n        class=\"status\"\n        role=\"status\"\n        aria-live=\"polite\"\n      >\n        {{ status }}\n      </div>\n\n      <div\n        class=\"board\"\n        role=\"grid\"\n        aria-label=\"Tic tac toe board\"\n        aria-describedby=\"game-status\"\n      >\n        <div\n          v-for=\"(cell, i) in board\"\n          :key=\"i\"\n          class=\"cell-slot\"\n          role=\"gridcell\"\n        >\n          <button\n            :id=\"cellId(i)\"\n            :ref=\"(element) => setCellRef(element, i)\"\n            class=\"cell\"\n            :class=\"{ winning: isWinningCell(i) }\"\n            type=\"button\"\n            :tabindex=\"focusIndex === i ? 0 : -1\"\n            :aria-disabled=\"String(isCellDisabled(i))\"\n            :aria-label=\"cellLabel(i, cell)\"\n            :data-mark=\"cell ?? undefined\"\n            @focus=\"setFocusIndex(i)\"\n            @keydown=\"onCellKeydown($event, i)\"\n            @click=\"play(i)\"\n          >\n            {{ cell ?? '' }}\n          </button>\n        </div>\n      </div>\n\n      <div class=\"actions\">\n        <button class=\"ghost undo\" type=\"button\" :disabled=\"!canUndo\" @click=\"undo\">\n          Undo\n        </button>\n        <button class=\"ghost redo\" type=\"button\" :disabled=\"!canRedo\" @click=\"redo\">\n          Redo\n        </button>\n        <button class=\"ghost reset\" type=\"button\" @click=\"reset\">\n          Reset\n        </button>\n      </div>\n    </section>\n  </main>\n</template>\n\n<script setup lang=\"ts\">\nimport { computed, ref } from 'vue';\n\ntype Player = 'X' | 'O';\ntype Cell = Player | null;\ntype Board = Cell[];\ntype NavigationKey = 'ArrowLeft' | 'ArrowRight' | 'ArrowUp' | 'ArrowDown' | 'Home' | 'End';\n\nconst WINNING_LINES: number[][] = [\n  [0, 1, 2],\n  [3, 4, 5],\n  [6, 7, 8],\n  [0, 3, 6],\n  [1, 4, 7],\n  [2, 5, 8],\n  [0, 4, 8],\n  [2, 4, 6]\n];\n\nconst NAVIGATION_KEYS: NavigationKey[] = [\n  'ArrowLeft',\n  'ArrowRight',\n  'ArrowUp',\n  'ArrowDown',\n  'Home',\n  'End'\n];\n\nfunction createEmptyBoard(): Board {\n  return Array.from({ length: 9 }, () => null);\n}\n\nfunction calculateWinningLine(board: Board): number[] | null {\n  for (const line of WINNING_LINES) {\n    const [first, second, third] = line;\n    const mark = board[first];\n    if (mark && mark === board[second] && mark === board[third]) {\n      return line;\n    }\n  }\n\n  return null;\n}\n\nconst history = ref<Board[]>([createEmptyBoard()]);\nconst cursor = ref(0);\nconst focusIndex = ref(0);\nconst cellRefs: Array<HTMLButtonElement | null> = Array.from({ length: 9 }, () => null);\n\nconst board = computed<Board>(() => history.value[cursor.value]);\nconst currentPlayer = computed<Player>(() => cursor.value % 2 === 0 ? 'X' : 'O');\nconst winningLine = computed<number[] | null>(() => calculateWinningLine(board.value));\nconst winner = computed<Player | null>(() => {\n  const line = winningLine.value;\n  return line ? board.value[line[0]] as Player : null;\n});\nconst isDraw = computed(() => (\n  !winner.value && board.value.every((cell) => cell !== null)\n));\nconst isGameOver = computed(() => winner.value !== null || isDraw.value);\nconst status = computed(() => {\n  if (winner.value) return 'Winner: ' + winner.value;\n  if (isDraw.value) return 'Draw';\n  return 'Next: ' + currentPlayer.value;\n});\nconst canUndo = computed(() => cursor.value > 0);\nconst canRedo = computed(() => cursor.value < history.value.length - 1);\n\nconst cellId = (index: number): string => 'tic-tac-toe-cell-' + index;\n\nconst cellLabel = (index: number, cell: Cell): string => {\n  const row = Math.floor(index / 3) + 1;\n  const column = (index % 3) + 1;\n  return 'Row ' + row + ', column ' + column + ': ' + (cell ?? 'empty');\n};\n\nconst isWinningCell = (index: number): boolean => (\n  winningLine.value?.includes(index) ?? false\n);\n\nconst isCellDisabled = (index: number): boolean => (\n  isGameOver.value || board.value[index] !== null\n);\n\nconst play = (index: number) => {\n  if (isGameOver.value || board.value[index] !== null) return;\n\n  const nextBoard = board.value.slice();\n  nextBoard[index] = currentPlayer.value;\n  const retainedHistory = history.value.slice(0, cursor.value + 1);\n  history.value = [...retainedHistory, nextBoard];\n  cursor.value += 1;\n};\n\nconst undo = () => {\n  if (!canUndo.value) return;\n  cursor.value -= 1;\n};\n\nconst redo = () => {\n  if (!canRedo.value) return;\n  cursor.value += 1;\n};\n\nconst reset = () => {\n  history.value = [createEmptyBoard()];\n  cursor.value = 0;\n  focusIndex.value = 0;\n};\n\nconst setCellRef = (element: Element | null, index: number) => {\n  cellRefs[index] = element as HTMLButtonElement | null;\n};\n\nconst setFocusIndex = (index: number) => {\n  focusIndex.value = index;\n};\n\nconst focusCell = (index: number) => {\n  focusIndex.value = index;\n  cellRefs[index]?.focus();\n};\n\nconst onCellKeydown = (event: KeyboardEvent, index: number) => {\n  const key = event.key as NavigationKey;\n  if (!NAVIGATION_KEYS.includes(key)) return;\n\n  event.preventDefault();\n  const row = Math.floor(index / 3);\n  const column = index % 3;\n  let nextIndex = index;\n\n  if (key === 'ArrowLeft') nextIndex = row * 3 + (column + 2) % 3;\n  else if (key === 'ArrowRight') nextIndex = row * 3 + (column + 1) % 3;\n  else if (key === 'ArrowUp') nextIndex = ((row + 2) % 3) * 3 + column;\n  else if (key === 'ArrowDown') nextIndex = ((row + 1) % 3) * 3 + column;\n  else if (key === 'Home') nextIndex = row * 3;\n  else if (key === 'End') nextIndex = row * 3 + 2;\n\n  focusCell(nextIndex);\n};\n</script>\n",
    "src/App.css": ":root {\n  color-scheme: dark;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nhtml, body {\n  margin: 0;\n  height: 100%;\n  background: #0a0a0a;\n}\n\nbody {\n  font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;\n}\n\n.page {\n  min-height: 100vh;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n  background: #0a0a0a;\n  color: #e5e7eb;\n}\n\n.card {\n  width: 100%;\n  max-width: 520px;\n  padding: 18px;\n  display: grid;\n  gap: 14px;\n  border: 1px solid #1f2937;\n  border-radius: 14px;\n  background: #0b1020;\n}\n\n.title {\n  margin: 0;\n  font-size: 18px;\n  font-weight: 800;\n}\n\n.subtitle {\n  margin: 0;\n  color: #9ca3af;\n  font-size: 12px;\n}\n\n.status {\n  padding: 10px 12px;\n  border: 1px solid #1f2937;\n  border-radius: 12px;\n  background: #0a0f1e;\n  font-weight: 700;\n}\n\n.board {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 10px;\n}\n\n.cell-slot {\n  min-width: 0;\n  aspect-ratio: 1 / 1;\n}\n\n.cell {\n  width: 100%;\n  height: 100%;\n  display: grid;\n  place-items: center;\n  border: 1px solid rgba(31, 41, 55, .7);\n  border-radius: 14px;\n  background: #0a0f1e;\n  color: #e5e7eb;\n  font-size: 34px;\n  font-weight: 900;\n  cursor: pointer;\n}\n\n.cell[aria-disabled=\"true\"] {\n  cursor: not-allowed;\n}\n\n.cell.winning {\n  border-color: #a3e635;\n  background: #1a2e05;\n  color: #ecfccb;\n}\n\n.cell:focus-visible {\n  outline: 3px solid #facc15;\n  outline-offset: 2px;\n}\n\n.actions {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: flex-end;\n  gap: 8px;\n}\n\n.ghost {\n  padding: 10px 14px;\n  border: 1px solid #374151;\n  border-radius: 12px;\n  background: transparent;\n  color: #e5e7eb;\n  font-weight: 800;\n  cursor: pointer;\n}\n\n.ghost:disabled {\n  opacity: .45;\n  cursor: not-allowed;\n}\n\n@media (max-width: 520px) {\n  .page {\n    padding: 14px;\n  }\n}\n",
    "tsconfig.json": "{\n  \"compilerOptions\": {\n    \"target\": \"ES2020\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"Node\",\n    \"strict\": true,\n    \"allowJs\": true\n  }\n}\n"
  }
}
