{
  "dependencies": {
    "vue": "3.x"
  },
  "openFile": "/src/App.vue",
  "files": {
    "package.json": "{\n  \"name\": \"vue-chessboard-click-highlight-pressure-solution\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"dependencies\": {\n    \"vue\": \"3.x\"\n  },\n  \"scripts\": {\n    \"serve\": \"vue-cli-service serve\"\n  }\n}\n",
    "public/index.html": "<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Vue SDK • Chessboard Click Highlight (pressure solution)</title></head><body><div id='app'></div></body></html>",
    "src/main.ts": "import { createApp } from 'vue';\nimport App from './App.vue';\nimport './App.css';\n\ncreateApp(App).mount('#app');\n",
    "src/App.vue": "<template>\n  <main class='page'>\n    <section class='card'>\n      <h1>Chessboard Click / Highlight</h1>\n      <p class='subtitle'>\n        Select one square, inspect every blocker-free queen move, and navigate the grid by keyboard.\n      </p>\n\n      <label class='size' for='board-size'>\n        Board size (N)\n        <input\n          id='board-size'\n          type='number'\n          :min=\"MIN_SIZE\"\n          :max=\"MAX_SIZE\"\n          :value=\"size\"\n          @input=\"onSizeInput(String(($event.target && $event.target.value) || ''))\"\n        />\n      </label>\n\n      <p id='board-status' class='status' role='status' aria-live='polite'>\n        <span class='selection-status'>{{ selectionStatus }}</span>\n        <span v-if=\"selected\" class='reachability-status'>Queen moves: {{ queenMoves }}</span>\n      </p>\n\n      <div\n        class='board'\n        role='grid'\n        aria-label='Interactive chessboard'\n        aria-describedby='board-status'\n        :aria-rowcount=\"size\"\n        :aria-colcount=\"size\"\n        :style=\"{ gridTemplateColumns: 'repeat(' + size + ', minmax(0, 1fr))' }\"\n      >\n        <template v-for=\"boardRow in rows\" :key=\"'r-' + boardRow\">\n          <button\n            v-for=\"boardCol in cols\"\n            :key=\"cellId(boardRow, boardCol)\"\n            :id=\"cellId(boardRow, boardCol)\"\n            :ref=\"setCellRef\"\n            :class=\"cellClass(boardRow, boardCol)\"\n            type='button'\n            role='gridcell'\n            :data-row=\"boardRow\"\n            :data-col=\"boardCol\"\n            :data-reachable=\"isQueenReachable(boardRow, boardCol) ? 'true' : undefined\"\n            :aria-rowindex=\"boardRow + 1\"\n            :aria-colindex=\"boardCol + 1\"\n            :aria-label=\"cellLabel(boardRow, boardCol)\"\n            :aria-pressed=\"String(isSelected(boardRow, boardCol))\"\n            :tabindex=\"focusIndex === cellIndex(boardRow, boardCol) ? 0 : -1\"\n            @focus=\"setFocusIndex(cellIndex(boardRow, boardCol))\"\n            @keydown=\"onCellKeydown($event, cellIndex(boardRow, boardCol))\"\n            @click=\"onCellClick(boardRow, boardCol)\"\n          ></button>\n        </template>\n      </div>\n    </section>\n  </main>\n</template>\n\n<script setup lang=\"ts\">\nimport { computed, ref } from 'vue';\n\ntype Coordinate = { row: number; col: number };\ntype NavigationKey = 'ArrowLeft' | 'ArrowRight' | 'ArrowUp' | 'ArrowDown' | 'Home' | 'End';\n\nconst MIN_SIZE = 2;\nconst MAX_SIZE = 20;\nconst NAVIGATION_KEYS: NavigationKey[] = [\n  'ArrowLeft',\n  'ArrowRight',\n  'ArrowUp',\n  'ArrowDown',\n  'Home',\n  'End'\n];\n\nconst size = ref(8);\nconst selected = ref<Coordinate | null>(null);\nconst focusIndex = ref(0);\nconst cellRefs = new Map<string, HTMLButtonElement>();\n\nconst rows = computed(() => Array.from({ length: size.value }, (_, index) => index));\nconst cols = computed(() => Array.from({ length: size.value }, (_, index) => index));\n\nconst cellId = (row: number, col: number): string => (\n  'chessboard-cell-' + row + '-' + col\n);\n\nconst cellIndex = (row: number, col: number): number => row * size.value + col;\n\nconst isSelected = (row: number, col: number): boolean => (\n  selected.value?.row === row && selected.value.col === col\n);\n\nconst isQueenReachable = (row: number, col: number): boolean => {\n  if (!selected.value || isSelected(row, col)) return false;\n  const rowDistance = Math.abs(row - selected.value.row);\n  const colDistance = Math.abs(col - selected.value.col);\n  return rowDistance === 0 || colDistance === 0 || rowDistance === colDistance;\n};\n\nconst selectionStatus = computed(() => {\n  if (!selected.value) return 'Selected: none';\n  return 'Selected: row ' + (selected.value.row + 1) + ', column ' + (selected.value.col + 1);\n});\n\nconst queenMoves = computed(() => {\n  if (!selected.value) return 0;\n  let count = 0;\n  for (let row = 0; row < size.value; row += 1) {\n    for (let col = 0; col < size.value; col += 1) {\n      if (isQueenReachable(row, col)) count += 1;\n    }\n  }\n  return count;\n});\n\nconst onSizeInput = (raw: string) => {\n  const parsed = Number(raw);\n  size.value = Number.isFinite(parsed)\n    ? Math.min(MAX_SIZE, Math.max(MIN_SIZE, Math.trunc(parsed)))\n    : MIN_SIZE;\n  selected.value = null;\n  focusIndex.value = 0;\n  cellRefs.clear();\n};\n\nconst onCellClick = (row: number, col: number) => {\n  selected.value = { row, col };\n};\n\nconst cellClass = (row: number, col: number): string => {\n  const classes = [\n    'cell',\n    (row + col) % 2 === 1 ? 'cell--dark' : 'cell--light'\n  ];\n  if (isSelected(row, col)) classes.push('cell--active');\n  if (isQueenReachable(row, col)) classes.push('cell--reachable');\n  return classes.join(' ');\n};\n\nconst cellLabel = (row: number, col: number): string => {\n  const base = 'Row ' + (row + 1) + ', column ' + (col + 1);\n  if (isSelected(row, col)) return base + ', selected';\n  if (isQueenReachable(row, col)) return base + ', reachable by queen';\n  return base;\n};\n\nconst setCellRef = (element: Element | null) => {\n  if (element instanceof HTMLButtonElement) {\n    cellRefs.set(element.id, element);\n  }\n};\n\nconst setFocusIndex = (index: number) => {\n  focusIndex.value = index;\n};\n\nconst focusCell = (index: number) => {\n  focusIndex.value = index;\n  const row = Math.floor(index / size.value);\n  const col = index % size.value;\n  cellRefs.get(cellId(row, col))?.focus();\n};\n\nconst onCellKeydown = (event: KeyboardEvent, index: number) => {\n  const key = event.key as NavigationKey;\n  if (!NAVIGATION_KEYS.includes(key)) return;\n\n  event.preventDefault();\n  const row = Math.floor(index / size.value);\n  const col = index % size.value;\n  let nextIndex = index;\n\n  if (key === 'ArrowLeft') nextIndex = row * size.value + (col + size.value - 1) % size.value;\n  else if (key === 'ArrowRight') nextIndex = row * size.value + (col + 1) % size.value;\n  else if (key === 'ArrowUp') nextIndex = ((row + size.value - 1) % size.value) * size.value + col;\n  else if (key === 'ArrowDown') nextIndex = ((row + 1) % size.value) * size.value + col;\n  else if (key === 'Home') nextIndex = row * size.value;\n  else if (key === 'End') nextIndex = row * size.value + size.value - 1;\n\n  focusCell(nextIndex);\n};\n</script>\n",
    "src/App.css": ":root {\n  color-scheme: dark;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nhtml, body, #app {\n  margin: 0;\n  min-width: 0;\n  min-height: 100%;\n  background: #0a0a0a;\n}\n\nbody {\n  font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;\n}\n\n.page {\n  width: 100%;\n  min-height: 100vh;\n  padding: 24px;\n  display: grid;\n  place-items: center;\n  color: #e5e7eb;\n}\n\n.card {\n  width: 100%;\n  max-width: 760px;\n  min-width: 0;\n  padding: 18px;\n  display: grid;\n  gap: 14px;\n  border: 1px solid #1f2937;\n  border-radius: 14px;\n  background: #0b1020;\n}\n\nh1 {\n  margin: 0;\n  font-size: 20px;\n}\n\n.subtitle {\n  margin: 0;\n  color: #9ca3af;\n  font-size: 13px;\n}\n\n.size {\n  width: max-content;\n  display: inline-grid;\n  gap: 6px;\n  color: #9ca3af;\n  font-size: 12px;\n}\n\n.size input {\n  width: 90px;\n  padding: 8px 10px;\n  border: 1px solid #374151;\n  border-radius: 10px;\n  background: #0a0f1e;\n  color: #e5e7eb;\n}\n\n.status {\n  margin: 0;\n  padding: 8px 10px;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px 16px;\n  border: 1px solid #1f2937;\n  border-radius: 10px;\n  background: #0a0f1e;\n  font-size: 13px;\n}\n\n.reachability-status {\n  color: #bfdbfe;\n}\n\n.board {\n  width: 100%;\n  max-width: 560px;\n  min-width: 0;\n  display: grid;\n  overflow: hidden;\n  border: 1px solid #374151;\n  border-radius: 12px;\n}\n\n.cell {\n  width: 100%;\n  min-width: 0;\n  padding: 0;\n  aspect-ratio: 1 / 1;\n  border: none;\n  outline: none;\n  cursor: pointer;\n  box-shadow: inset 0 0 0 1px rgba(15, 23, 42, 0.15);\n  transition: box-shadow 120ms ease;\n}\n\n.cell--light {\n  background: #e5e7eb;\n}\n\n.cell--dark {\n  background: #334155;\n}\n\n.cell:hover {\n  box-shadow: inset 0 0 0 2px rgba(14, 165, 233, 0.65);\n}\n\n.cell--reachable {\n  box-shadow: inset 0 0 0 3px #38bdf8;\n}\n\n.cell--active {\n  box-shadow: inset 0 0 0 3px #facc15;\n}\n\n.cell:focus-visible {\n  position: relative;\n  z-index: 1;\n  box-shadow: inset 0 0 0 3px #a3e635;\n}\n\n@media (max-width: 520px) {\n  .page {\n    padding: 12px;\n  }\n\n  .card {\n    padding: 14px;\n  }\n}\n",
    "tsconfig.json": "{\n  \"compilerOptions\": {\n    \"target\": \"ES2020\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"Node\",\n    \"strict\": true,\n    \"allowJs\": true\n  }\n}\n"
  }
}
