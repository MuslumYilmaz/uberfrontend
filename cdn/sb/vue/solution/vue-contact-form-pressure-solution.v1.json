{
  "dependencies": {
    "vue": "3.x"
  },
  "openFile": "/src/App.vue",
  "files": {
    "src/App.vue": "<template>\n  <main class=\"main\">\n    <section class=\"section\">\n      <h1>Contact Us</h1>\n\n      <form class=\"panel\" novalidate @submit=\"handleSubmit\" @input=\"clearSuccess\">\n        <div class=\"field\">\n          <label for=\"name\">Name</label>\n          <input\n            id=\"name\"\n            type=\"text\"\n            v-model=\"name\"\n            :aria-invalid=\"showError('name') ? 'true' : 'false'\"\n            :aria-describedby=\"showError('name') ? 'name-error' : undefined\"\n            @blur=\"touched.name = true\"\n          />\n          <p v-if=\"showError('name')\" id=\"name-error\" class=\"error\">{{ errors.name }}</p>\n        </div>\n\n        <div class=\"field\">\n          <label for=\"email\">Email</label>\n          <input\n            id=\"email\"\n            type=\"email\"\n            v-model=\"email\"\n            :aria-invalid=\"showError('email') ? 'true' : 'false'\"\n            :aria-describedby=\"showError('email') ? 'email-error' : undefined\"\n            @blur=\"touched.email = true\"\n          />\n          <p v-if=\"showError('email')\" id=\"email-error\" class=\"error\">{{ errors.email }}</p>\n        </div>\n\n        <div class=\"field\">\n          <label for=\"message\">Message</label>\n          <textarea\n            id=\"message\"\n            rows=\"4\"\n            v-model=\"message\"\n            :aria-invalid=\"showError('message') ? 'true' : 'false'\"\n            :aria-describedby=\"showError('message') ? 'message-error' : undefined\"\n            @blur=\"touched.message = true\"\n          />\n          <p v-if=\"showError('message')\" id=\"message-error\" class=\"error\">{{ errors.message }}</p>\n        </div>\n\n        <button type=\"submit\" class=\"primary\" :disabled=\"isSubmitting\">\n          {{ isSubmitting ? 'Sending…' : 'Send message' }}\n        </button>\n\n        <p v-if=\"successMessage\" class=\"success\" role=\"status\">{{ successMessage }}</p>\n        <p v-if=\"errorMessage\" class=\"error\" role=\"alert\">{{ errorMessage }}</p>\n      </form>\n    </section>\n  </main>\n</template>\n\n<script setup lang=\"ts\">\nimport { computed, onUnmounted, ref } from 'vue';\n\ntype FieldName = 'name' | 'email' | 'message';\n\nconst TIME_LIMIT_MS = 2000;\n\nconst name = ref('');\nconst email = ref('');\nconst message = ref('');\n\nconst touched = ref<Record<FieldName, boolean>>({ name: false, email: false, message: false });\n\nconst isSubmitting = ref(false);\nconst successMessage = ref('');\nconst errorMessage = ref('');\n\nlet controller: AbortController | null = null;\nlet timerId: number | undefined;\n\nconst errors = computed<Partial<Record<FieldName, string>>>(() => {\n  const nameText = name.value.trim();\n  const emailText = email.value.trim();\n  const messageText = message.value.trim();\n\n  return {\n    name: nameText ? undefined : 'Name is required.',\n    email: !emailText\n      ? 'Email is required.'\n      : /\\S+@\\S+\\.\\S+/.test(emailText)\n        ? undefined\n        : 'Enter a valid email address.',\n    message: !messageText\n      ? 'Message is required.'\n      : messageText.length >= 10\n        ? undefined\n        : 'Message should be at least 10 characters.'\n  };\n});\n\nfunction showError(field: FieldName): boolean {\n  return touched.value[field] && !!errors.value[field];\n}\n\nfunction clearSuccess() {\n  successMessage.value = '';\n}\n\nfunction stopRequest() {\n  window.clearTimeout(timerId);\n  timerId = undefined;\n  controller?.abort();\n  controller = null;\n}\n\nasync function sendMessage(signal: AbortSignal): Promise<void> {\n  // The live preview has no network, so it falls back to a short fake request.\n  if (typeof fetch !== 'function') {\n    await new Promise<void>((resolve, reject) => {\n      const fakeTimer = window.setTimeout(resolve, 600);\n      signal.addEventListener('abort', () => {\n        window.clearTimeout(fakeTimer);\n        reject(new DOMException('Request cancelled', 'AbortError'));\n      });\n    });\n    return;\n  }\n\n  const response = await fetch('https://jsonplaceholder.typicode.com/posts', {\n    method: 'POST',\n    headers: { 'Content-Type': 'application/json' },\n    body: JSON.stringify({\n      name: name.value.trim(),\n      email: email.value.trim(),\n      message: message.value.trim()\n    }),\n    signal\n  });\n\n  if (!response.ok) {\n    throw new Error('Request failed');\n  }\n}\n\nconst handleSubmit = async (event: Event) => {\n  event.preventDefault();\n  if (isSubmitting.value) return;\n\n  successMessage.value = '';\n  errorMessage.value = '';\n  touched.value = { name: true, email: true, message: true };\n\n  const firstInvalid = (['name', 'email', 'message'] as FieldName[]).find((field) => errors.value[field]);\n  if (firstInvalid) {\n    document.getElementById(firstInvalid)?.focus();\n    return;\n  }\n\n  const request = new AbortController();\n  let timedOut = false;\n  controller = request;\n  timerId = window.setTimeout(() => {\n    timedOut = true;\n    request.abort();\n  }, TIME_LIMIT_MS);\n  isSubmitting.value = true;\n\n  try {\n    await sendMessage(request.signal);\n    successMessage.value = 'Your message has been sent. Thank you!';\n    name.value = '';\n    email.value = '';\n    message.value = '';\n    touched.value = { name: false, email: false, message: false };\n  } catch {\n    // An abort without the time limit means the component is gone.\n    if (request.signal.aborted && !timedOut) return;\n    errorMessage.value = timedOut\n      ? 'The server took too long. Please try again.'\n      : 'Something went wrong. Please try again.';\n  } finally {\n    window.clearTimeout(timerId);\n    controller = null;\n    isSubmitting.value = false;\n  }\n};\n\nonUnmounted(stopRequest);\n</script>\n",
    "src/App.css": ":root {\n  color-scheme: dark;\n}\n\nhtml, body {\n  margin: 0;\n  height: 100%;\n  background: #020617;\n  font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;\n}\n\n.main {\n  min-height: 100vh;\n  background: #020617;\n  color: #e5e7eb;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n}\n\n.section {\n  width: 100%;\n  max-width: 480px;\n  display: grid;\n  gap: 16px;\n}\n\nh1 {\n  margin: 0;\n  font-size: 20px;\n  font-weight: 700;\n}\n\n.panel {\n  background: #020617;\n  border: 1px solid #1f2937;\n  border-radius: 12px;\n  padding: 16px;\n  display: grid;\n  gap: 12px;\n}\n\n.field {\n  display: grid;\n  gap: 4px;\n}\n\nlabel {\n  font-size: 13px;\n  color: #9ca3af;\n}\n\ninput, textarea {\n  background: #020617;\n  border-radius: 8px;\n  border: 1px solid #1f2937;\n  padding: 8px 10px;\n  color: #e5e7eb;\n  font-size: 14px;\n}\n\ninput:focus, textarea:focus {\n  outline: none;\n  border-color: #6366f1;\n  box-shadow: 0 0 0 1px #6366f1;\n}\n\nbutton.primary {\n  margin-top: 4px;\n  background: #4ade80;\n  color: #022c22;\n  border: none;\n  border-radius: 999px;\n  padding: 10px 16px;\n  font-weight: 600;\n  font-size: 14px;\n  cursor: pointer;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n}\n\nbutton.primary[disabled] {\n  opacity: .6;\n  cursor: not-allowed;\n}\n\n.success {\n  margin: 4px 0 0;\n  font-size: 13px;\n  color: #22c55e;\n}\n\n.error {\n  margin: 4px 0 0;\n  font-size: 13px;\n  color: #f97316;\n}\n"
  }
}
