{
  "dependencies": {
    "vue": "3.x"
  },
  "openFile": "/src/App.vue",
  "files": {
    "src/App.vue": "<template>\n  <main class=\"app-root\">\n    <section class=\"card\" aria-labelledby=\"faq-heading\">\n      <header class=\"header\">\n        <h1 id=\"faq-heading\">FAQ (Pressure Solution)</h1>\n        <label class=\"mode-toggle\">\n          <input\n            type=\"checkbox\"\n            :checked=\"allowMultiple\"\n            @change=\"onAllowMultipleChange\"\n          />\n          <span>Allow multiple open</span>\n        </label>\n      </header>\n\n      <div class=\"faq-list\">\n        <FaqItem\n          v-for=\"(item, index) in faqItems\"\n          :key=\"item.id\"\n          :item-id=\"item.id\"\n          :question=\"item.question\"\n          :answer=\"item.answer\"\n          :is-open=\"isItemOpen(item.id)\"\n          @toggle=\"onItemToggle(item.id)\"\n          @navigate=\"onItemNavigate(index, $event)\"\n        />\n      </div>\n    </section>\n  </main>\n</template>\n\n<script setup lang=\"ts\">\nimport { defineComponent, h, ref } from 'vue';\n\ntype NavigationKey = 'ArrowDown' | 'ArrowUp' | 'Home' | 'End';\n\ntype Faq = {\n  id: string;\n  question: string;\n  answer: string;\n};\n\nconst navigationKeys: NavigationKey[] = ['ArrowDown', 'ArrowUp', 'Home', 'End'];\n\nconst FaqItem = defineComponent({\n  name: 'FaqItem',\n  props: {\n    itemId: { type: String, required: true },\n    question: { type: String, required: true },\n    answer: { type: String, required: true },\n    isOpen: { type: Boolean, required: true }\n  },\n  emits: {\n    toggle: () => true,\n    navigate: (key: NavigationKey) => navigationKeys.includes(key)\n  },\n  setup(props, { emit }) {\n    const onHeaderKeydown = (event: KeyboardEvent) => {\n      const navigationKey = event.key as NavigationKey;\n      if (!navigationKeys.includes(navigationKey)) return;\n\n      event.preventDefault();\n      emit('navigate', navigationKey);\n    };\n\n    return () => {\n      const triggerId = 'faq-trigger-' + props.itemId;\n      const panelId = 'faq-panel-' + props.itemId;\n\n      return h(\n        'article',\n        { class: ['faq-item', { open: props.isOpen }] },\n        [\n          h(\n            'button',\n            {\n              id: triggerId,\n              type: 'button',\n              class: 'faq-header',\n              'aria-expanded': String(props.isOpen),\n              'aria-controls': panelId,\n              onClick: () => emit('toggle'),\n              onKeydown: onHeaderKeydown\n            },\n            [\n              h('span', { class: 'question' }, props.question),\n              h(\n                'span',\n                { class: 'indicator', 'aria-hidden': 'true' },\n                props.isOpen ? '-' : '+'\n              )\n            ]\n          ),\n          props.isOpen\n            ? h(\n                'div',\n                {\n                  id: panelId,\n                  class: 'faq-body',\n                  role: 'region',\n                  'aria-labelledby': triggerId\n                },\n                [h('p', props.answer)]\n              )\n            : null\n        ]\n      );\n    };\n  }\n});\n\nconst faqItems: Faq[] = [\n  {\n    id: 'faq-1',\n    question: 'Lorem ipsum dolor sit amet?',\n    answer: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed non risus euismod, posuere justo ut, pulvinar neque.'\n  },\n  {\n    id: 'faq-2',\n    question: 'Curabitur blandit tempus porttitor?',\n    answer: 'Curabitur blandit tempus porttitor. Integer posuere erat a ante venenatis dapibus posuere velit aliquet.'\n  },\n  {\n    id: 'faq-3',\n    question: 'Aenean lacinia bibendum nulla sed consectetur?',\n    answer: 'Aenean lacinia bibendum nulla sed consectetur. Cras justo odio, dapibus ac facilisis in, egestas eget quam.'\n  },\n  {\n    id: 'faq-4',\n    question: 'Vivamus sagittis lacus vel augue laoreet rutrum?',\n    answer: 'Vivamus sagittis lacus vel augue laoreet rutrum faucibus dolor auctor. Maecenas faucibus mollis interdum.'\n  }\n];\n\nconst allowMultiple = ref(false);\nconst openItemIds = ref<string[]>([]);\n\nconst isItemOpen = (itemId: string): boolean => openItemIds.value.includes(itemId);\n\nconst onItemToggle = (itemId: string) => {\n  if (isItemOpen(itemId)) {\n    openItemIds.value = openItemIds.value.filter((openId) => openId !== itemId);\n    return;\n  }\n\n  openItemIds.value = allowMultiple.value\n    ? [...openItemIds.value, itemId]\n    : [itemId];\n};\n\nconst onAllowMultipleChange = (event: Event) => {\n  const nextAllowMultiple = (event.target as HTMLInputElement).checked;\n  allowMultiple.value = nextAllowMultiple;\n\n  if (!nextAllowMultiple) {\n    openItemIds.value = openItemIds.value.slice(0, 1);\n  }\n};\n\nconst onItemNavigate = (itemIndex: number, key: NavigationKey) => {\n  let nextIndex = itemIndex;\n\n  if (key === 'ArrowDown') {\n    nextIndex = (itemIndex + 1) % faqItems.length;\n  } else if (key === 'ArrowUp') {\n    nextIndex = (itemIndex - 1 + faqItems.length) % faqItems.length;\n  } else if (key === 'Home') {\n    nextIndex = 0;\n  } else if (key === 'End') {\n    nextIndex = faqItems.length - 1;\n  }\n\n  const nextItem = faqItems[nextIndex];\n  document.getElementById('faq-trigger-' + nextItem.id)?.focus();\n};\n</script>\n",
    "src/App.css": ":root {\n  color-scheme: dark;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nhtml, body {\n  margin: 0;\n  min-height: 100%;\n  background: #020617;\n  font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;\n}\n\n.app-root {\n  min-height: 100vh;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n  background: #020617;\n  color: #e5e7eb;\n}\n\n.card {\n  width: min(100%, 560px);\n  padding: 20px;\n  border: 1px solid #1f2937;\n  border-radius: 16px;\n  background: #020617;\n}\n\n.header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  margin-bottom: 12px;\n}\n\n.header h1 {\n  margin: 0;\n  font-size: 20px;\n  font-weight: 700;\n}\n\n.mode-toggle {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  color: #cbd5e1;\n  font-size: 12px;\n}\n\n.faq-list {\n  display: grid;\n  gap: 8px;\n  margin-top: 4px;\n}\n\n.faq-item {\n  overflow: hidden;\n  border: 1px solid #1f2937;\n  border-radius: 12px;\n  background: #0b1020;\n  transition: background-color .15s ease, border-color .15s ease;\n}\n\n.faq-item.open {\n  border-color: #4b5563;\n  background: #020617;\n}\n\n.faq-header {\n  width: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  padding: 12px 14px;\n  border: 0;\n  background: transparent;\n  color: #e5e7eb;\n  font: inherit;\n  font-size: 14px;\n  text-align: left;\n  cursor: pointer;\n}\n\n.faq-header:hover {\n  background: rgba(148, 163, 184, .08);\n}\n\n.faq-header:focus-visible {\n  outline: 3px solid #facc15;\n  outline-offset: -3px;\n}\n\n.indicator {\n  flex: 0 0 auto;\n  font-weight: 700;\n}\n\n.faq-body {\n  padding: 0 14px 12px;\n  color: #9ca3af;\n  font-size: 13px;\n}\n\n.faq-body p {\n  margin: 0;\n}\n\n@media (max-width: 520px) {\n  .app-root {\n    padding: 14px;\n  }\n\n  .header {\n    align-items: flex-start;\n    flex-direction: column;\n  }\n}\n"
  }
}
