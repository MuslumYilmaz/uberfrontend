{
  "dependencies": {
    "vue": "3.x"
  },
  "openFile": "/src/App.vue",
  "files": {
    "src/App.vue": "<template>\n  <main class=\"main\">\n    <section\n      class=\"section\"\n      role=\"region\"\n      aria-roledescription=\"carousel\"\n      aria-label=\"Image slider\"\n      tabindex=\"0\"\n      @keydown=\"onKeydown\"\n    >\n      <h1>Image Slider</h1>\n\n      <div v-if=\"currentSlide\" class=\"slider-body\">\n        <figure class=\"frame\">\n          <img\n            class=\"image\"\n            :src=\"currentSlide.imageUrl\"\n            :alt=\"currentSlide.title\"\n          />\n          <figcaption class=\"caption\">{{ currentSlide.title }}</figcaption>\n        </figure>\n\n        <div class=\"meta\" :aria-live=\"isPlaying ? 'off' : 'polite'\">\n          Slide {{ currentIndex + 1 }} of {{ totalSlides }}\n        </div>\n\n        <div class=\"actions\">\n          <button type=\"button\" @click=\"prev\" :disabled=\"!canGoPrev\">\n            Previous\n          </button>\n          <button type=\"button\" @click=\"next\" :disabled=\"!canGoNext\">\n            Next\n          </button>\n        </div>\n\n        <div class=\"dots\">\n          <button\n            v-for=\"(slide, index) in slides\"\n            :key=\"slide.id\"\n            type=\"button\"\n            class=\"dot\"\n            :class=\"{ 'dot--active': index === currentIndex }\"\n            @click=\"goTo(index)\"\n            :aria-label=\"slide.title\"\n            :aria-current=\"index === currentIndex ? 'true' : null\"\n          ></button>\n        </div>\n      </div>\n\n      <p v-else class=\"empty-state\">No slides left</p>\n\n      <div class=\"tools\">\n        <button type=\"button\" class=\"autoplay-toggle\" @click=\"togglePlaying\" :disabled=\"!canPlay\">\n          {{ isPlaying ? 'Pause' : 'Play' }}\n        </button>\n        <button v-if=\"currentSlide\" type=\"button\" class=\"remove-slide\" @click=\"removeCurrent\">\n          Remove slide\n        </button>\n      </div>\n    </section>\n  </main>\n</template>\n\n<script setup lang=\"ts\">\nimport { computed, onUnmounted, ref, watch } from 'vue';\n\ntype Slide = {\n  id: number;\n  title: string;\n  imageUrl: string;\n};\n\nconst AUTOPLAY_MS = 1000;\n\nconst slides = ref<Slide[]>([\n  {\n    id: 1,\n    title: 'Snowflakes glowing under city lights',\n    imageUrl: 'https://picsum.photos/seed/slide-1/800/400'\n  },\n  {\n    id: 2,\n    title: 'Forest trail in the morning',\n    imageUrl: 'https://images.pexels.com/photos/1563604/pexels-photo-1563604.jpeg'\n  },\n  {\n    id: 3,\n    title: 'City lights at night',\n    imageUrl: 'https://images.pexels.com/photos/220067/pexels-photo-220067.jpeg'\n  }\n]);\n\nconst currentIndex = ref(0);\nconst playRequested = ref(false);\n\nconst totalSlides = computed(() => slides.value.length);\nconst currentSlide = computed(() => slides.value[currentIndex.value] ?? null);\n\nconst canGoPrev = computed(() => currentIndex.value > 0);\nconst canGoNext = computed(() => currentIndex.value < totalSlides.value - 1);\nconst canPlay = computed(() => totalSlides.value >= 2);\nconst isPlaying = computed(() => playRequested.value && canPlay.value);\n\nlet timer: ReturnType<typeof setTimeout> | undefined;\n\n// The index is watched too, so any move, by the timer or the user, restarts the wait.\nwatch([isPlaying, currentIndex, totalSlides], () => {\n  clearTimeout(timer);\n  if (!isPlaying.value) return;\n  timer = setTimeout(() => {\n    currentIndex.value = (currentIndex.value + 1) % totalSlides.value;\n  }, AUTOPLAY_MS);\n});\n\nonUnmounted(() => clearTimeout(timer));\n\nconst goTo = (index: number) => {\n  if (index < 0 || index >= totalSlides.value) return;\n  currentIndex.value = index;\n};\n\nconst prev = () => {\n  if (canGoPrev.value) goTo(currentIndex.value - 1);\n};\n\nconst next = () => {\n  if (canGoNext.value) goTo(currentIndex.value + 1);\n};\n\nconst togglePlaying = () => {\n  playRequested.value = !isPlaying.value;\n};\n\nconst removeCurrent = () => {\n  slides.value = slides.value.filter((_, position) => position !== currentIndex.value);\n  currentIndex.value = Math.max(0, Math.min(currentIndex.value, totalSlides.value - 1));\n};\n\nconst onKeydown = (event: KeyboardEvent) => {\n  if (event.key === 'ArrowRight') next();\n  else if (event.key === 'ArrowLeft') prev();\n  else if (event.key === 'Home') goTo(0);\n  else if (event.key === 'End') goTo(totalSlides.value - 1);\n  else return;\n  event.preventDefault();\n};\n</script>\n",
    "src/App.css": ":root {\n  color-scheme: dark;\n}\n\nhtml, body {\n  margin: 0;\n  height: 100%;\n  background: #0a0a0a;\n  font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;\n}\n\n.main {\n  min-height: 100vh;\n  background: #0a0a0a;\n  color: #e5e7eb;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n}\n\n.section {\n  width: 100%;\n  max-width: 520px;\n  display: grid;\n  gap: 16px;\n}\n\nh1 {\n  margin: 0;\n  font-size: 20px;\n  font-weight: 700;\n}\n\n.frame {\n  margin: 0;\n  border-radius: 12px;\n  overflow: hidden;\n  border: 1px solid #1f2937;\n  background: #020617;\n}\n\n.image {\n  display: block;\n  width: 100%;\n  height: 240px;\n  object-fit: cover;\n}\n\n.caption {\n  padding: 8px 12px;\n  font-size: 14px;\n  color: #e5e7eb;\n  background: rgba(15,23,42,.9);\n}\n\n.meta {\n  font-size: 12px;\n  color: #9ca3af;\n  text-align: center;\n}\n\n.actions {\n  display: flex;\n  gap: 8px;\n  justify-content: center;\n  margin-top: 4px;\n}\n\nbutton {\n  background: #a3e635;\n  color: #111;\n  border: none;\n  border-radius: 10px;\n  padding: 10px 14px;\n  font-weight: 700;\n  cursor: pointer;\n}\n\nbutton[disabled] {\n  opacity: .5;\n  cursor: not-allowed;\n}\n\n.dots {\n  display: flex;\n  justify-content: center;\n  gap: 6px;\n  margin-top: 6px;\n}\n\n.dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 999px;\n  border: none;\n  background: #374151;\n  cursor: pointer;\n  padding: 0;\n}\n\n.dot.dot--active {\n  background: #a3e635;\n}\n\n.section:focus-visible {\n  outline: 2px solid #a3e635;\n  outline-offset: 6px;\n  border-radius: 4px;\n}\n\n.slider-body {\n  display: grid;\n  gap: 16px;\n}\n\n.tools {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 8px;\n}\n\n.tools button {\n  background: transparent;\n  color: #e5e7eb;\n  border: 1px solid #374151;\n}\n\n.empty-state {\n  margin: 0;\n  padding: 24px 12px;\n  border: 1px dashed #374151;\n  border-radius: 12px;\n  color: #9ca3af;\n  text-align: center;\n}\n"
  }
}
