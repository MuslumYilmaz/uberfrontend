#
# Backend environment variables (example)
#
# Copy this file to `.env` (which is gitignored) and fill in values.
#

# App
NODE_ENV=development
PORT=3001

# Database
# Local development should use the Mongo `test` database by default.
# Only switch to `MONGO_TARGET=production` for explicit production-local maintenance.
MONGO_TARGET=test
MONGO_URL=mongodb://127.0.0.1:27017/frontendatlas
MONGO_URL_TEST=mongodb://127.0.0.1:27017/test
EXPECTED_MONGO_DB_NAME_TEST=test

# Auth / JWT
# - In production, JWT_SECRET is required and should be 32+ chars.
JWT_SECRET=replace-with-a-strong-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_SESSION_TTL_DAYS=90

# Cookie auth
# - access token is stored in an httpOnly cookie (default name: access_token)
# - COOKIE_SAMESITE=none requires COOKIE_SECURE=true and enables CSRF double-submit checks
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# OAuth (optional)
# Base URLs used to build OAuth redirect/callback URLs.
SERVER_BASE=http://localhost:3001
FRONTEND_BASE=http://localhost:4200
# Comma-separated allowed frontend origins for CORS/OAuth redirects.
# Include 127.0.0.1 and the common local test/preview ports used in this repo.
FRONTEND_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4310,http://127.0.0.1:4310,http://localhost:4173,http://127.0.0.1:4173
FRONTEND_ORIGIN=http://localhost:4200

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Proxy / rate limiting
TRUST_PROXY=false
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=1200
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
# `auto` uses Upstash when configured and process-local memory otherwise.
RATE_LIMIT_STORE=auto
RATE_LIMIT_REDIS_FAIL_CLOSED=false
RATE_LIMIT_NAMESPACE=frontendatlas
# Shared limiter/readiness timeout. Invalid values outside 100-10000 ms use 1500.
RATE_LIMIT_REDIS_TIMEOUT_MS=1500
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public contact / bug-report protection
# Keep this true in production. Tests may set it false to use the process-local
# deterministic store; public-form Redis errors never fall back in production.
PUBLIC_FORM_REDIS_REQUIRED=true
PUBLIC_FORM_REDIS_TIMEOUT_MS=3000
TURNSTILE_SECRET_KEY=
# Only enable in development/test with Cloudflare's exact official dummy secret.
TURNSTILE_ALLOW_DUMMY_KEYS=false
# Hostnames only (no scheme, port, path, or wildcard), comma separated.
TURNSTILE_ALLOWED_HOSTNAMES=frontendatlas.com,www.frontendatlas.com
TURNSTILE_VERIFY_TIMEOUT_MS=3000
TURNSTILE_TOKEN_MAX_AGE_MS=300000
PUBLIC_FORM_DUP_WINDOW_MS=600000
PUBLIC_FORM_MAX_URL_CHARS=2000

# Backend Sentry (optional)
# Leave SENTRY_DSN empty to keep backend Sentry disabled locally.
SENTRY_ENABLED=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Activity
WEEKLY_TARGET=5

# Interview Mode access: `off` (default), `internal` (admins only), `cohort`, or `public`.
# Public production access accepts only editorial-gold/calibrated-gold artifacts.
# Internal mode can preview candidate artifacts only for a DB-resolved admin.
INTERVIEW_MODE_ACCESS=off
# Cohort access requires both a stable secret salt and a non-zero basis-point value.
INTERVIEW_ROLLOUT_BPS=0
INTERVIEW_ROLLOUT_SALT=
# `drain` blocks discovery/create but preserves active session resume/mutations/results.
# `halt` also blocks active mutations. Both remain live on /api/health/interview.
INTERVIEW_OPERATIONAL_STATE=normal
# Explicit operator attestations. Cohort/public launch readiness fails closed unless
# both have been changed to true after monitoring and native Safari sign-off.
INTERVIEW_MONITORING_READY=false
INTERVIEW_NATIVE_SAFARI_READY=false
# Manual staging-only multi-instance verification (the CLI is dry-run by default):
# INTERVIEW_REDIS_VERIFY_NAMESPACE=staging-interview
# INTERVIEW_REDIS_VERIFY_ACK=non-production-staging
# Legacy fallback used only when INTERVIEW_MODE_ACCESS is unset. `true` maps to
# internal admin preview, never public access:
# INTERVIEW_MODE_ENABLED=false
# This standalone override requires NODE_ENV=development or NODE_ENV=test.
INTERVIEW_ALLOW_CANDIDATE_BANK=false
INTERVIEW_RUN_TOKEN_SECRET=replace-with-a-separate-strong-secret-at-least-32-chars
INTERVIEW_FREE_MONTHLY_LIMIT=1
INTERVIEW_MCQ_SECONDS=600
INTERVIEW_CODING_READY_SECONDS=300
# Guided System Design is independently fail-closed and also requires
# INTERVIEW_MODE_ACCESS to permit the current user.
INTERVIEW_SYSTEM_DESIGN_ACCESS=off
INTERVIEW_SYSTEM_DESIGN_FREE_MONTHLY_LIMIT=1
INTERVIEW_RETENTION_DAYS=90
INTERVIEW_MAX_DRAFT_FILES=30
INTERVIEW_MAX_DRAFT_FILE_BYTES=102400
INTERVIEW_MAX_DRAFT_TOTAL_BYTES=512000
INTERVIEW_MAX_CHECK_RUNS=50
# Optional absolute artifact overrides:
# INTERVIEW_BANK_PUBLIC_PATH=
# INTERVIEW_BANK_PRIVATE_PATH=
# INTERVIEW_BANK_RELEASE_PATH=
# INTERVIEW_CODING_PUBLIC_PATH=
# INTERVIEW_CODING_PRIVATE_PATH=
# INTERVIEW_CODING_RELEASE_PATH=
# INTERVIEW_SYSTEM_DESIGN_PUBLIC_PATH=
# INTERVIEW_SYSTEM_DESIGN_PRIVATE_PATH=
# INTERVIEW_SYSTEM_DESIGN_RELEASE_PATH=

# Payments / checkout start
BILLING_PROVIDER=lemonsqueezy
# Active hosted checkout providers today: `lemonsqueezy`, `gumroad`.
# `stripe` stays reserved until the full checkout + webhook + portal flow is shipped.
PAYMENTS_MODE=test
# Use `test` for local/E2E. Production should use `live`.
# Public pricing metadata and sequential-offer attribution.
BILLING_TAX_INCLUSIVE=true
BILLING_OFFER_VERSION=pricing_baseline_v1
BILLING_CHECKOUT_SURFACE=hosted_new_tab
# Discounts are off unless a bounded server allowlist is deliberately configured.
BILLING_DISCOUNT_CAMPAIGNS_JSON=[]
# Example only (keep the provider code server-side; never accept it from clients):
# BILLING_DISCOUNT_CAMPAIGNS_JSON=[{"enabled":true,"campaignId":"partner_august","provider":"lemonsqueezy","providerDiscountId":"discount_123","discountCode":"PARTNER15","modes":["live"],"planIds":["quarterly","annual"],"analyticsSources":["partner_august"],"startsAt":"2026-08-01T00:00:00.000Z","endsAt":"2026-09-01T00:00:00.000Z"}]
GUMROAD_MONTHLY_URL=
GUMROAD_QUARTERLY_URL=
GUMROAD_ANNUAL_URL=
LEMONSQUEEZY_MONTHLY_URL=
LEMONSQUEEZY_QUARTERLY_URL=
LEMONSQUEEZY_ANNUAL_URL=
LEMONSQUEEZY_LIFETIME_URL=
LEMONSQUEEZY_MONTHLY_URL_TEST=
LEMONSQUEEZY_QUARTERLY_URL_TEST=
LEMONSQUEEZY_ANNUAL_URL_TEST=
LEMONSQUEEZY_LIFETIME_URL_TEST=
LEMONSQUEEZY_MONTHLY_URL_LIVE=
LEMONSQUEEZY_QUARTERLY_URL_LIVE=
LEMONSQUEEZY_ANNUAL_URL_LIVE=
LEMONSQUEEZY_LIFETIME_URL_LIVE=
# Read-only price parity uses scoped LemonSqueezy variant ids. Live never falls
# back to an unscoped/test id.
LEMONSQUEEZY_MONTHLY_VARIANT_ID_TEST=
LEMONSQUEEZY_QUARTERLY_VARIANT_ID_TEST=
LEMONSQUEEZY_ANNUAL_VARIANT_ID_TEST=
LEMONSQUEEZY_LIFETIME_VARIANT_ID_TEST=
LEMONSQUEEZY_MONTHLY_VARIANT_ID_LIVE=
LEMONSQUEEZY_QUARTERLY_VARIANT_ID_LIVE=
LEMONSQUEEZY_ANNUAL_VARIANT_ID_LIVE=
LEMONSQUEEZY_LIFETIME_VARIANT_ID_LIVE=
STRIPE_MONTHLY_URL=
STRIPE_QUARTERLY_URL=
STRIPE_ANNUAL_URL=
STRIPE_LIFETIME_URL=

# Billing / webhook secrets
GUMROAD_WEBHOOK_SECRET=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_WEBHOOK_SECRET_TEST=
LEMONSQUEEZY_WEBHOOK_SECRET_LIVE=
LEMONSQUEEZY_API_KEY=
# Prefer mode-scoped read-only keys for audits. The unscoped key remains the
# backwards-compatible live customer-portal fallback.
LEMONSQUEEZY_API_KEY_TEST=
LEMONSQUEEZY_API_KEY_LIVE=
LEMONSQUEEZY_STORE_ID=
STRIPE_WEBHOOK_SECRET=

# Public-form email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SUPPORT_EMAIL=support@frontendatlas.com

# Contact endpoint IP, normalized-email, and payload limits
CONTACT_BURST_WINDOW_MS=60000
CONTACT_BURST_MAX=2
CONTACT_WINDOW_MS=3600000
CONTACT_MAX=5
CONTACT_EMAIL_HOURLY_WINDOW_MS=3600000
CONTACT_EMAIL_HOURLY_MAX=3
CONTACT_EMAIL_DAILY_WINDOW_MS=86400000
CONTACT_EMAIL_DAILY_MAX=5
CONTACT_MAX_NAME_CHARS=120
CONTACT_MAX_EMAIL_CHARS=320
CONTACT_MIN_MESSAGE_CHARS=10
CONTACT_MAX_MESSAGE_CHARS=4000

# Bug-report endpoint IP and payload limits
BUG_REPORT_BURST_WINDOW_MS=60000
BUG_REPORT_BURST_MAX=2
BUG_REPORT_WINDOW_MS=3600000
BUG_REPORT_MAX=5
BUG_REPORT_MIN_NOTE_CHARS=8
BUG_REPORT_MAX_NOTE_CHARS=4000
