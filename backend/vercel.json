{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "includeFiles": "content/**",
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/internal/seo/daily-sync",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/internal/seo/weekly-digest",
      "schedule": "0 6 * * 1"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" }
  ]
}
