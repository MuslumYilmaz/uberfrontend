          "requiredLiterals": [
            "draft.save",
            "draft.send",
            "thread.labels.set"
          ]
        },
        {
          "group": "offline-email-client-contract",
          "name": "MailboxEvent",
          "requiredLiterals": [
            "message.upserted",
            "message.removed",
            "thread.updated",
            "label.updated",
            "draft.replaced"
          ]
        }
      ]
    },
