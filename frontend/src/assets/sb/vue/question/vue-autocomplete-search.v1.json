    "files": {
        "package.json": "{\n  \"name\": \"vue-autocomplete-search\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"dependencies\": {\n    \"vue\": \"3.x\"\n  },\n  \"scripts\": {\n    \"serve\": \"vue-cli-service serve\"\n  }\n}\n",
        "public/index.html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Vue SDK • Autocomplete</title></head><body><div id=\"app\"></div></body></html>",
        "src/main.ts": "import { createApp } from 'vue';\nimport App from './App.vue';\nimport './App.css';\n\ncreateApp(App).mount('#app');\n",
        "src/App.vue": "<template>\n  <main class=\"page\">\n    <section class=\"card\">\n      <h1 class=\"title\">Autocomplete</h1>\n\n      <div\n        ref=\"rootRef\"\n        class=\"combo\"\n        role=\"combobox\"\n        aria-haspopup=\"listbox\"\n        :aria-expanded=\"isOpen\"\n        :aria-owns=\"listboxId\"\n        :aria-activedescendant=\"activeDesc\"\n      >\n        <label class=\"label\" for=\"q\">Search</label>\n        <input\n          id=\"q\"\n          class=\"input\"\n          type=\"text\"\n          autocomplete=\"off\"\n          placeholder=\"Type a city...\"\n          :value=\"query\"\n          @input=\"onInput\"\n          @focus=\"onFocus\"\n          @keydown=\"onKeyDown\"\n        />\n\n        <ul v-if=\"isOpen\" class=\"list\" role=\"listbox\" :id=\"listboxId\">\n          <li\n            v-for=\"(item, i) in results\"\n            :key=\"item\"\n            class=\"option\"\n            :class=\"{ active: i === activeIndex }\"\n            role=\"option\"\n            :id=\"optionId(i)\"\n            :aria-selected=\"i === activeIndex\"\n            @mousedown=\"select(item)\"\n            v-html=\"highlight(item, query)\"\n          />\n\n          <li v-if=\"isLoading\" class=\"empty\">Loading…</li>\n          <li v-else-if=\"results.length === 0\" class=\"empty\">No results</li>\n        </ul>\n      </div>\n\n      <p class=\"hint\">Keyboard: ↑/↓ navigate, Enter select, Esc close.</p>\n    </section>\n  </main>\n</template>\n\n<script setup lang=\"ts\">\nimport { computed, onBeforeUnmount, onMounted, ref, watch } from 'vue';\n\nconst listboxId = 'autocomplete-listbox';\n\nconst CITIES: string[] = [\n  'Amsterdam', 'Ankara', 'Athens', 'Austin',\n  'Barcelona', 'Berlin', 'Boston', 'Brussels',\n  'Chicago', 'Copenhagen',\n  'Dubai',\n  'Edinburgh',\n  'Frankfurt',\n  'Hamburg',\n  'Istanbul', 'Izmir',\n  'London', 'Los Angeles',\n  'Madrid', 'Miami', 'Milan', 'Munich',\n  'New York',\n  'Oslo',\n  'Paris', 'Prague',\n  'Rome',\n  'San Diego', 'San Francisco', 'San Jose', 'Seattle',\n  'Tokyo',\n  'Vienna',\n  'Zurich'\n];\n\nconst rootRef = ref<HTMLElement | null>(null);\n\nconst query = ref('');\nconst isOpen = ref(false);\nconst activeIndex = ref(-1);\nconst results = ref<string[]>([]);\nconst isLoading = ref(false);\n\nconst activeDesc = computed(() => (activeIndex.value >= 0 ? optionId(activeIndex.value) : undefined));\n\n// TODO: Debounced search based on `query`\n// - trim query\n// - if empty => close + clear results + set isLoading=false\n// - else open + set isLoading=true, debounce 300ms, then call search(q)\n// - use stale-result protection\nwatch(query, () => {\n  // TODO\n});\n\nfunction onInput(e: Event) {\n  // TODO: set query from input value\n}\n\nfunction onFocus() {\n  // TODO: if trimmed query non-empty => open dropdown\n}\n\nfunction onKeyDown(ev: KeyboardEvent) {\n  // TODO: ArrowUp/ArrowDown/Enter/Escape\n}\n\nfunction select(value: string) {\n  // TODO: set query, close dropdown, reset activeIndex\n}\n\nfunction optionId(i: number): string {\n  return `opt-${i}`;\n}\n\nfunction highlight(item: string, queryRaw: unknown): string {\n  // TODO: escape HTML + highlight match using <mark> (case-insensitive)\n  return escapeHtml(String(item));\n}\n\nfunction escapeHtml(s: string): string {\n  return s\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\\\"/g, '&quot;')\n    .replace(/'/g, '&#39;');\n}\n\n// TODO: outside click close (document mousedown)\nonMounted(() => {\n  // TODO\n});\n\nonBeforeUnmount(() => {\n  // TODO\n});\n\nasync function search(q: string): Promise<string[]> {\n  // TODO: filter CITIES, return max 8, simulate latency (~150ms)\n  return [];\n}\n</script>\n",
        "src/App.css": ":root {\n  color-scheme: dark;\n}\n\nhtml,body {\n  margin: 0;\n  height: 100%;\n  background: #0a0a0a;\n}\n\nbody {\n  font-family: system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;\n}\n\n.page {\n  min-height: 100vh;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n  background: #0a0a0a;\n  color: #e5e7eb;\n}\n\n.card {\n  width: 100%;\n  max-width: 520px;\n  background: #0b1020;\n  border: 1px solid #1f2937;\n  border-radius: 14px;\n  padding: 18px;\n  display: grid;\n  gap: 14px;\n}\n\n.title {\n  margin: 0;\n  font-size: 18px;\n  font-weight: 800;\n}\n\n.label {\n  display: block;\n  font-size: 12px;\n  color: #9ca3af;\n  margin-bottom: 6px;\n}\n\n.combo {\n  position: relative;\n}\n\n.input {\n  width: 100%;\n  padding: 12px 12px;\n  border-radius: 12px;\n  border: 1px solid #374151;\n  background: #0a0f1e;\n  color: #e5e7eb;\n  outline: none;\n}\n\n.input:focus {\n  border-color: #a3e635;\n  box-shadow: 0 0 0 2px rgba(163,230,53,.15);\n}\n\n.list {\n  position: absolute;\n  z-index: 10;\n  left: 0;\n  right: 0;\n  margin-top: 8px;\n  max-height: 240px;\n  overflow: auto;\n  border-radius: 12px;\n  border: 1px solid #1f2937;\n  background: #0a0f1e;\n}\n\n.option {\n  padding: 10px 12px;\n  cursor: pointer;\n  border-bottom: 1px solid rgba(31,41,55,.5);\n}\n\n.option:last-child {\n  border-bottom: none;\n}\n\n.option.active {\n  background: rgba(163,230,53,.12);\n}\n\n.empty {\n  padding: 10px 12px;\n  color: #9ca3af;\n}\n\n.hint {\n  margin: 0;\n  color: #9ca3af;\n  font-size: 12px;\n}\n\nmark {\n  background: rgba(163,230,53,.25);\n  color: #e5e7eb;\n  border-radius: 4px;\n  padding: 0 2px;\n}\n",
        "tsconfig.json": "{\n  \"compilerOptions\": {\n    \"target\": \"ES2020\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"Node\",\n    \"strict\": true,\n    \"allowJs\": true\n  }\n}\n"
