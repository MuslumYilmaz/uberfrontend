{
    "dependencies": {
        "vue": "3.x"
    },
    "openFile": "/src/App.vue",
    "files": {
        "package.json": "{\n  \"name\": \"vue-nested-checkboxes\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"dependencies\": {\n    \"vue\": \"3.x\"\n  },\n  \"scripts\": {\n    \"serve\": \"vue-cli-service serve\"\n  }\n}\n",
        "public/index.html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Vue SDK • Nested Checkboxes</title></head><body><div id=\"app\"></div></body></html>",
        "src/main.ts": "import { createApp } from 'vue';\nimport App from './App.vue';\nimport './App.css';\n\ncreateApp(App).mount('#app');\n",
        "src/App.vue": "<template>\n  <main class=\"main\">\n    <section class=\"section\">\n      <h1>Nested Checkboxes</h1>\n\n      <div class=\"panel\">\n        <label class=\"parent\">\n          <input\n            type=\"checkbox\"\n            v-model=\"allChecked\"\n            :indeterminate=\"someChecked\"\n          />\n          <span>Parent</span>\n        </label>\n\n        <div class=\"children\">\n          <label\n            v-for=\"child in children\"\n            :key=\"child.id\"\n            class=\"child\"\n          >\n            <input type=\"checkbox\" v-model=\"child.checked\" />\n            <span>{{ child.label }}</span>\n          </label>\n        </div>\n      </div>\n    </section>\n  </main>\n</template>\n\n<script setup lang=\"ts\">\nimport { computed, ref } from 'vue';\n\ntype ChildNode = {\n  id: string;\n  label: string;\n  checked: boolean;\n};\n\n// Children list. Each child checkbox writes its own flag through v-model.\nconst children = ref<ChildNode[]>([\n  { id: 'c1', label: 'Child 1', checked: false },\n  { id: 'c2', label: 'Child 2', checked: false },\n  { id: 'c3', label: 'Child 3', checked: false }\n]);\n\n// TODO: the parent has no state of its own: it is checked, unchecked or indeterminate depending on the children.\n// Read it from them (checked when every child is checked); setting it (a click on the parent) checks or unchecks every child.\nconst allChecked = computed({\n  get: () => false,\n  set: (_checked: boolean) => {\n    // starter: no-op so the UI renders\n  }\n});\n\n// TODO: true when some children are checked but not all; the template binds it to the parent's indeterminate.\nconst someChecked = computed(() => false);\n</script>\n",
        "src/App.css": ":root {\n  color-scheme: dark;\n}\n\nhtml, body {\n  margin: 0;\n  height: 100%;\n  background: #0a0a0a;\n  font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;\n}\n\n.main {\n  min-height: 100vh;\n  background: #0a0a0a;\n  color: #e5e7eb;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n}\n\n.section {\n  width: 100%;\n  max-width: 420px;\n  display: grid;\n  gap: 16px;\n}\n\nh1 {\n  margin: 0;\n  font-size: 20px;\n  font-weight: 700;\n}\n\n.panel {\n  background: #0b1020;\n  border: 1px solid #1f2937;\n  border-radius: 12px;\n  padding: 16px;\n  display: grid;\n  gap: 12px;\n}\n\n.parent {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 16px;\n  font-weight: 600;\n}\n\n.children {\n  display: grid;\n  gap: 6px;\n  margin-left: 24px;\n}\n\n.child {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 14px;\n}\n\n.child input[type=checkbox], .parent input[type=checkbox] {\n  width: 16px;\n  height: 16px;\n}\n",
        "tsconfig.json": "{\n  \"compilerOptions\": {\n    \"target\": \"ES2020\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"Node\",\n    \"strict\": true,\n    \"allowJs\": true\n  }\n}\n"
    }
}