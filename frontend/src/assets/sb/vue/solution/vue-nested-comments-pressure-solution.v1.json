{
  "dependencies": {
    "vue": "3.x"
  },
  "openFile": "/src/App.vue",
  "files": {
    "src/App.vue": "<template>\n  <main class=\"page\">\n    <section class=\"card\">\n      <h1 class=\"title\">Nested Comments</h1>\n      <p class=\"subtitle\">Replies nest at any depth, long threads can be hidden, and delete keeps other replies.</p>\n\n      <div class=\"composer\">\n        <textarea\n          id=\"comment-box\"\n          v-model=\"topDraft\"\n          rows=\"3\"\n          aria-label=\"Write a comment\"\n          placeholder=\"Write a comment...\"\n        ></textarea>\n        <button @click=\"addTop\">Add Comment</button>\n      </div>\n\n      <div class=\"list\">\n        <Tree :nodes=\"comments\" :depth=\"0\" />\n      </div>\n\n      <p class=\"thread-status\" aria-live=\"polite\">{{ threadStatus }}</p>\n    </section>\n  </main>\n</template>\n\n<script setup lang=\"ts\">\nimport { defineComponent, h, nextTick, ref } from 'vue';\n\ntype CommentNode = {\n  id: string;\n  text: string;\n  deleted: boolean;\n  children: CommentNode[];\n};\n\nfunction insertReply(nodes: CommentNode[], parentId: string, reply: CommentNode): CommentNode[] {\n  return nodes.map((node) =>\n    node.id === parentId\n      ? { ...node, children: [...node.children, reply] }\n      : { ...node, children: insertReply(node.children, parentId, reply) }\n  );\n}\n\nfunction deleteFromTree(nodes: CommentNode[], id: string): CommentNode[] {\n  return nodes.flatMap((node) => {\n    if (node.id === id) {\n      return node.children.length ? [{ ...node, text: '[deleted]', deleted: true }] : [];\n    }\n    const children = deleteFromTree(node.children, id);\n    // A placeholder has nothing left to show once its last reply is gone.\n    if (node.deleted && children.length === 0) return [];\n    return [{ ...node, children }];\n  });\n}\n\nfunction countReplies(node: CommentNode): number {\n  return node.children.reduce((total, child) => total + 1 + countReplies(child), 0);\n}\n\nfunction containsComment(node: CommentNode, id: string): boolean {\n  return node.children.some((child) => child.id === id || containsComment(child, id));\n}\n\nconst comments = ref<CommentNode[]>([\n  { id: '1', text: 'First comment', deleted: false, children: [] }\n]);\nconst topDraft = ref('');\nconst activeReplyId = ref<string | null>(null);\nconst drafts = ref<Record<string, string>>({});\nconst hiddenIds = ref<Record<string, boolean>>({});\nconst threadStatus = ref('');\n\nconst nextId = ref(2);\nconst makeId = () => String(nextId.value++);\n\n// The element to focus may only exist after this render, so wait for the DOM.\nconst focusAfterRender = (elementId: string) => {\n  nextTick(() => document.getElementById(elementId)?.focus());\n};\n\nconst addTop = () => {\n  const text = topDraft.value.trim();\n  if (!text) return;\n  comments.value = [{ id: makeId(), text, deleted: false, children: [] }, ...comments.value];\n  topDraft.value = '';\n};\n\nconst openReply = (id: string) => {\n  activeReplyId.value = id;\n  focusAfterRender(`reply-input-${id}`);\n};\n\nconst cancelReply = (id: string) => {\n  delete drafts.value[id];\n  activeReplyId.value = null;\n  focusAfterRender(`reply-button-${id}`);\n};\n\nconst submitReply = (id: string) => {\n  const text = (drafts.value[id] ?? '').trim();\n  if (!text) return;\n  comments.value = insertReply(comments.value, id, { id: makeId(), text, deleted: false, children: [] });\n  hiddenIds.value[id] = false;\n  delete drafts.value[id];\n  activeReplyId.value = null;\n  threadStatus.value = 'Reply added';\n  focusAfterRender(`reply-button-${id}`);\n};\n\nconst toggleReplies = (node: CommentNode) => {\n  const hide = !hiddenIds.value[node.id];\n  hiddenIds.value[node.id] = hide;\n  if (hide && activeReplyId.value && containsComment(node, activeReplyId.value)) {\n    activeReplyId.value = null;\n  }\n};\n\nconst deleteComment = (id: string) => {\n  comments.value = deleteFromTree(comments.value, id);\n  delete drafts.value[id];\n  if (activeReplyId.value === id) activeReplyId.value = null;\n  threadStatus.value = 'Comment deleted';\n  focusAfterRender('comment-box');\n};\n\nconst onReplyKeydown = (event: KeyboardEvent, id: string) => {\n  if (event.key === 'Enter') {\n    event.preventDefault();\n    submitReply(id);\n  }\n  if (event.key === 'Escape') cancelReply(id);\n};\n\nconst Tree = defineComponent({\n  name: 'Tree',\n  props: {\n    nodes: { type: Array as () => CommentNode[], required: true },\n    depth: { type: Number, required: true }\n  },\n  setup(props) {\n    return () =>\n      h(\n        'div',\n        {},\n        props.nodes.map((c) => {\n          const replyCount = countReplies(c);\n          const hidden = !!hiddenIds.value[c.id];\n          const replyLabel = `Reply to ${c.text}`;\n\n          return h(\n            'div',\n            { class: 'node', style: { marginLeft: `${props.depth * 16}px` }, key: c.id },\n            [\n              h('div', { class: 'bubble' }, [\n                h('div', { class: 'text' }, c.text),\n                h('div', { class: 'meta' }, [\n                  c.deleted\n                    ? null\n                    : h(\n                        'button',\n                        {\n                          id: `reply-button-${c.id}`,\n                          class: 'ghost reply-button',\n                          'aria-label': replyLabel,\n                          onClick: () => openReply(c.id)\n                        },\n                        'Reply'\n                      ),\n                  replyCount > 0\n                    ? h(\n                        'button',\n                        {\n                          class: 'ghost toggle-replies',\n                          'aria-expanded': String(!hidden),\n                          onClick: () => toggleReplies(c)\n                        },\n                        `${hidden ? 'Show' : 'Hide'} replies (${replyCount})`\n                      )\n                    : null,\n                  c.deleted\n                    ? null\n                    : h(\n                        'button',\n                        {\n                          class: 'ghost delete-comment',\n                          'aria-label': `Delete ${c.text}`,\n                          onClick: () => deleteComment(c.id)\n                        },\n                        'Delete'\n                      )\n                ]),\n\n                activeReplyId.value === c.id\n                  ? h('div', { class: 'reply' }, [\n                      h('input', {\n                        id: `reply-input-${c.id}`,\n                        'aria-label': replyLabel,\n                        value: drafts.value[c.id] ?? '',\n                        onInput: (e: Event) => (drafts.value[c.id] = (e.target as HTMLInputElement).value),\n                        onKeydown: (e: KeyboardEvent) => onReplyKeydown(e, c.id),\n                        placeholder: 'Write a reply...'\n                      }),\n                      h('div', { class: 'replyActions' }, [\n                        h('button', { onClick: () => submitReply(c.id) }, 'Post'),\n                        h('button', { class: 'ghost', onClick: () => cancelReply(c.id) }, 'Cancel')\n                      ])\n                    ])\n                  : null\n              ]),\n\n              c.children.length && !hidden\n                ? h(Tree, { nodes: c.children, depth: props.depth + 1 })\n                : null\n            ]\n          );\n        })\n      );\n  }\n});\n</script>\n",
    "src/App.css": ":root {\n  color-scheme: dark;\n}\n\nhtml, body {\n  margin: 0;\n  height: 100%;\n  background: #0a0a0a;\n  font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;\n}\n\n.page {\n  min-height: 100vh;\n  display: grid;\n  place-items: center;\n  background: #0a0a0a;\n  padding: 24px;\n}\n\n.card {\n  width: 100%;\n  max-width: 720px;\n  background: #0b1020;\n  border: 1px solid #1f2937;\n  border-radius: 16px;\n  padding: 18px;\n  display: grid;\n  gap: 14px;\n  color: #e5e7eb;\n}\n\n.title {\n  margin: 0;\n  font-size: 20px;\n  font-weight: 900;\n  color: #e5e7eb;\n}\n\n.subtitle {\n  margin: 0;\n  color: #9ca3af;\n  font-size: 12px;\n  line-height: 1.45;\n}\n\n.composer {\n  display: grid;\n  gap: 10px;\n}\n\ntextarea {\n  box-sizing: border-box;\n  width: 100%;\n  resize: vertical;\n  min-height: 70px;\n  background: #0a0f1e;\n  color: #e5e7eb;\n  border: 1px solid #1f2937;\n  border-radius: 12px;\n  padding: 10px;\n}\n\ntextarea::placeholder {\n  color: #6b7280;\n}\n\n.list {\n  display: grid;\n  gap: 10px;\n}\n\n.node {\n  display: grid;\n  gap: 8px;\n}\n\n.bubble {\n  background: #0a0f1e;\n  border: 1px solid #1f2937;\n  border-radius: 14px;\n  padding: 12px;\n  display: grid;\n  gap: 10px;\n  color: #e5e7eb;\n}\n\n.text {\n  font-size: 14px;\n  line-height: 1.4;\n  color: #e5e7eb;\n}\n\n.meta {\n  display: flex;\n  gap: 8px;\n}\n\n.reply {\n  display: grid;\n  gap: 8px;\n  margin-top: 6px;\n}\n\n.reply input {\n  width: 100%;\n  background: #0b1020;\n  color: #e5e7eb;\n  border: 1px solid #1f2937;\n  border-radius: 12px;\n  padding: 10px;\n}\n\n.reply input::placeholder {\n  color: #6b7280;\n}\n\n.replyActions {\n  display: flex;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\nbutton {\n  background: #a3e635;\n  color: #111;\n  border: none;\n  border-radius: 12px;\n  padding: 10px 14px;\n  font-weight: 900;\n  cursor: pointer;\n}\n\nbutton.ghost {\n  background: transparent;\n  color: #e5e7eb;\n  border: 1px solid #374151;\n}\n\n.hint {\n  color: #9ca3af;\n  font-size: 12px;\n  line-height: 1.45;\n}\n\n.meta {\n  flex-wrap: wrap;\n}\n\n.thread-status {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n  border: 0;\n}\n"
  }
}
