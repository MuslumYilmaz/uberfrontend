{
    "dependencies": {
        "vue": "3.x"
    },
    "openFile": "/src/App.vue",
    "files": {
        "package.json": "{\n  \"name\": \"vue-debounced-search-solution\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"dependencies\": {\n    \"vue\": \"3.x\"\n  },\n  \"scripts\": {\n    \"serve\": \"vue-cli-service serve\"\n  }\n}\n",
        "public/index.html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Vue SDK • Debounced Search (solution)</title></head><body><div id=\"app\"></div></body></html>",
        "src/main.ts": "import { createApp } from 'vue';\nimport App from './App.vue';\nimport './App.css';\n\ncreateApp(App).mount('#app');\n",
        "src/App.vue": "<template>\n  <main class=\"main\">\n    <section class=\"card\">\n      <header class=\"header\">\n        <h1 class=\"title\">Debounced Search (Solution)</h1>\n        <p class=\"subtitle\">\n          Type to search a fake user directory. Search runs 500ms after you stop typing.\n        </p>\n      </header>\n\n      <div class=\"field\">\n        <label class=\"label\" for=\"search-input\">Search</label>\n        <input\n          id=\"search-input\"\n          class=\"input\"\n          type=\"text\"\n          :value=\"query\"\n          @input=\"onInput\"\n          placeholder=\"Start typing a name or email...\"\n          autocomplete=\"off\"\n        />\n      </div>\n\n      <div class=\"status-row\">\n        <span v-if=\"isLoading\" class=\"status status--loading\">Searching…</span>\n        <span\n          v-else-if=\"!error && query\"\n          class=\"status\"\n        >\n          Showing {{ results.length }} result(s) for \"{{ query }}\"\n        </span>\n        <span\n          v-else-if=\"!error && !query\"\n          class=\"status status--muted\"\n        >\n          Start typing to search.\n        </span>\n        <span v-if=\"error\" class=\"status status--error\">{{ error }}</span>\n      </div>\n\n      <ul class=\"results\" v-if=\"results.length\">\n        <li class=\"result-row\" v-for=\"r in results\" :key=\"r.id\">\n          <div class=\"result-name\">{{ r.name }}</div>\n          <div class=\"result-email\">{{ r.email }}</div>\n        </li>\n      </ul>\n\n      <p\n        class=\"empty\"\n        v-if=\"!results.length && !isLoading && query && !error\"\n      >\n        No results found for \"{{ query }}\".\n      </p>\n    </section>\n  </main>\n</template>\n\n<script setup lang=\"ts\">\nimport { ref, watch } from 'vue';\n\ninterface Result {\n  id: number;\n  name: string;\n  email: string;\n}\n\nconst FAKE_DATA: Result[] = [\n  { id: 1, name: 'Alice Johnson', email: 'alice@example.com' },\n  { id: 2, name: 'Bob Smith', email: 'bob@example.com' },\n  { id: 3, name: 'Charlie Kim', email: 'charlie@example.com' },\n  { id: 4, name: 'Diana Lopez', email: 'diana@example.com' },\n  { id: 5, name: 'Ethan Brown', email: 'ethan@example.com' },\n  { id: 6, name: 'Fiona Patel', email: 'fiona@example.com' }\n];\n\nfunction fakeApiSearch(term: string): Promise<Result[]> {\n  const trimmed = term.trim().toLowerCase();\n  const delayMs = 600;\n\n  return new Promise((resolve, reject) => {\n    window.setTimeout(() => {\n      if (!trimmed) {\n        resolve([]);\n        return;\n      }\n\n      if (trimmed === 'error') {\n        reject(new Error('Fake API error'));\n        return;\n      }\n\n      const filtered = FAKE_DATA.filter((item) => {\n        const name = item.name.toLowerCase();\n        const mail = item.email.toLowerCase();\n        return name.includes(trimmed) || mail.includes(trimmed);\n      });\n\n      resolve(filtered);\n    }, delayMs);\n  });\n}\n\nconst query = ref('');\nconst results = ref<Result[]>([]);\nconst isLoading = ref(false);\nconst error = ref<string | null>(null);\n\nlet timeoutId: number | undefined;\n\nwatch(\n  query,\n  (value, _oldValue, onInvalidate) => {\n    const trimmed = value.trim();\n\n    if (timeoutId !== undefined) {\n      window.clearTimeout(timeoutId);\n      timeoutId = undefined;\n    }\n\n    if (!trimmed) {\n      results.value = [];\n      isLoading.value = false;\n      error.value = null;\n      return;\n    }\n\n    isLoading.value = true;\n    error.value = null;\n\n    timeoutId = window.setTimeout(() => {\n      fakeApiSearch(trimmed)\n        .then((data) => {\n          results.value = data;\n          isLoading.value = false;\n        })\n        .catch((err) => {\n          results.value = [];\n          isLoading.value = false;\n          error.value = err instanceof Error ? err.message : 'Something went wrong.';\n        });\n    }, 500);\n\n    onInvalidate(() => {\n      if (timeoutId !== undefined) {\n        window.clearTimeout(timeoutId);\n        timeoutId = undefined;\n      }\n    });\n  }\n);\n\nconst onInput = (event: Event) => {\n  const target = event.target as HTMLInputElement;\n  query.value = target.value;\n};\n</script>\n",
        "src/App.css": ":root {\n  color-scheme: dark;\n}\n\nhtml, body {\n  margin: 0;\n  height: 100%;\n  background: #020617;\n  font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;\n}\n\n.main {\n  min-height: 100vh;\n  background: #020617;\n  color: #e5e7eb;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n}\n\n.card {\n  width: 100%;\n  max-width: 640px;\n  background: #020617;\n  border-radius: 16px;\n  border: 1px solid #1f2937;\n  padding: 18px 18px 16px;\n  display: grid;\n  gap: 16px;\n}\n\n.header {\n  display: grid;\n  gap: 4px;\n}\n\n.title {\n  margin: 0;\n  font-size: 20px;\n  font-weight: 700;\n}\n\n.subtitle {\n  margin: 0;\n  font-size: 13px;\n  color: #9ca3af;\n}\n\n.field {\n  display: grid;\n  gap: 6px;\n}\n\n.label {\n  font-size: 13px;\n  color: #9ca3af;\n}\n\n.input {\n  width: 100%;\n  border-radius: 999px;\n  border: 1px solid #374151;\n  background: #020617;\n  color: #e5e7eb;\n  padding: 8px 12px;\n  font-size: 14px;\n  outline: none;\n}\n\n.input:focus {\n  border-color: #a3e635;\n  box-shadow: 0 0 0 1px #a3e63533;\n}\n\n.status-row {\n  min-height: 18px;\n  font-size: 12px;\n  display: flex;\n  align-items: center;\n}\n\n.status {\n  color: #9ca3af;\n}\n\n.status--loading {\n  color: #e5e7eb;\n}\n\n.status--muted {\n  color: #6b7280;\n}\n\n.status--error {\n  color: #f97316;\n}\n\n.results {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: grid;\n  gap: 8px;\n}\n\n.result-row {\n  padding: 8px 10px;\n  border-radius: 10px;\n  border: 1px solid #1f2937;\n  background: #020617;\n  display: grid;\n  gap: 2px;\n}\n\n.result-name {\n  font-size: 14px;\n  font-weight: 600;\n}\n\n.result-email {\n  font-size: 12px;\n  color: #9ca3af;\n  font-variant-numeric: tabular-nums;\n}\n\n.empty {\n  margin: 0;\n  font-size: 13px;\n  color: #6b7280;\n}\n",
        "tsconfig.json": "{\n  \"compilerOptions\": {\n    \"target\": \"ES2020\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"Node\",\n    \"strict\": true,\n    \"allowJs\": true\n  }\n}\n"
    }
}