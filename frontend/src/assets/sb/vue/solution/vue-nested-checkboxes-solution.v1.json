{
    "dependencies": {
        "vue": "3.x"
    },
    "openFile": "/src/App.vue",
    "files": {
        "package.json": "{\n  \"name\": \"vue-nested-checkboxes-solution\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"dependencies\": {\n    \"vue\": \"3.x\"\n  },\n  \"scripts\": {\n    \"serve\": \"vue-cli-service serve\"\n  }\n}\n",
        "public/index.html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Vue SDK • Nested Checkboxes (solution)</title></head><body><div id=\"app\"></div></body></html>",
        "src/main.ts": "import { createApp } from 'vue';\nimport App from './App.vue';\nimport './App.css';\n\ncreateApp(App).mount('#app');\n",
        "src/App.vue": "<template>\n  <main class=\"main\">\n    <section class=\"section\">\n      <h1>Nested Checkboxes (Solution)</h1>\n\n      <div class=\"panel\">\n        <label class=\"parent\">\n          <input\n            type=\"checkbox\"\n            :checked=\"parentChecked\"\n            :indeterminate=\"parentIndeterminate\"\n            @change=\"onParentChange\"\n          />\n          <span>Parent</span>\n        </label>\n\n        <div class=\"children\">\n          <label\n            v-for=\"child in children\"\n            :key=\"child.id\"\n            class=\"child\"\n          >\n            <input\n              type=\"checkbox\"\n              :checked=\"child.checked\"\n              @change=\"() => onChildChange(child.id)\"\n            />\n            <span>{{ child.label }}</span>\n          </label>\n        </div>\n      </div>\n    </section>\n  </main>\n</template>\n\n<script setup lang=\"ts\">\nimport { ref } from 'vue';\n\ntype ChildNode = {\n  id: string;\n  label: string;\n  checked: boolean;\n};\n\nconst children = ref<ChildNode[]>([\n  { id: 'c1', label: 'Child 1', checked: false },\n  { id: 'c2', label: 'Child 2', checked: false },\n  { id: 'c3', label: 'Child 3', checked: false }\n]);\n\n// Parent visual state\nconst parentChecked = ref(false);\nconst parentIndeterminate = ref(false);\n\nconst syncParentState = () => {\n  const total = children.value.length;\n  let checkedCount = 0;\n\n  for (const node of children.value) {\n    if (node.checked) checkedCount++;\n  }\n\n  if (checkedCount === 0) {\n    parentChecked.value = false;\n    parentIndeterminate.value = false;\n  } else if (checkedCount === total) {\n    parentChecked.value = true;\n    parentIndeterminate.value = false;\n  } else {\n    parentChecked.value = false;\n    parentIndeterminate.value = true;\n  }\n};\n\nconst onParentChange = (event: Event) => {\n  const input = event.target as HTMLInputElement;\n  const isChecked = input.checked;\n\n  for (const node of children.value) {\n    node.checked = isChecked;\n  }\n\n  syncParentState();\n};\n\nconst onChildChange = (id: string) => {\n  for (const node of children.value) {\n    if (node.id === id) {\n      node.checked = !node.checked;\n      break;\n    }\n  }\n\n  syncParentState();\n};\n\nsyncParentState();\n</script>\n",
        "src/App.css": ":root {\n  color-scheme: dark;\n}\n\nhtml, body {\n  margin: 0;\n  height: 100%;\n  background: #0a0a0a;\n  font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;\n}\n\n.main {\n  min-height: 100vh;\n  background: #0a0a0a;\n  color: #e5e7eb;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n}\n\n.section {\n  width: 100%;\n  max-width: 420px;\n  display: grid;\n  gap: 16px;\n}\n\nh1 {\n  margin: 0;\n  font-size: 20px;\n  font-weight: 700;\n}\n\n.panel {\n  background: #0b1020;\n  border: 1px solid #1f2937;\n  border-radius: 12px;\n  padding: 16px;\n  display: grid;\n  gap: 12px;\n}\n\n.parent {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 16px;\n  font-weight: 600;\n}\n\n.children {\n  display: grid;\n  gap: 6px;\n  margin-left: 24px;\n}\n\n.child {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 14px;\n}\n\n.child input[type=checkbox], .parent input[type=checkbox] {\n  width: 16px;\n  height: 16px;\n}\n",
        "tsconfig.json": "{\n  \"compilerOptions\": {\n    \"target\": \"ES2020\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"Node\",\n    \"strict\": true,\n    \"allowJs\": true\n  }\n}\n"
    }
}