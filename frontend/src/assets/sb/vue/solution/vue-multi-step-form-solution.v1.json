{
  "dependencies": {
    "vue": "3.x"
  },
  "openFile": "/src/App.vue",
  "files": {
    "package.json": "{\n  \"name\": \"vue-multi-step-form\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"dependencies\": {\n    \"vue\": \"3.x\"\n  },\n  \"scripts\": {\n    \"serve\": \"vue-cli-service serve\"\n  }\n}\n",
    "public/index.html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Vue SDK \u2022 Multi-step Signup</title></head><body><div id=\"app\"></div></body></html>",
    "src/main.ts": "import { createApp } from 'vue';\nimport App from './App.vue';\nimport './App.css';\n\ncreateApp(App).mount('#app');\n",
    "src/App.vue": "<template>\n  <main class=\"app\">\n    <section class=\"card\">\n      <header class=\"header\">\n        <h1>Multi-step Signup</h1>\n        <p class=\"subtitle\">Step {{ currentStep + 1 }} of 3</p>\n      </header>\n\n      <section class=\"steps\">\n        <div v-if=\"currentStep === 0\" class=\"step\">\n          <h2 class=\"step-title\">Basic info</h2>\n\n          <label class=\"field\">\n            <span>Name</span>\n            <input\n              type=\"text\"\n              placeholder=\"Jane Doe\"\n              v-model=\"form.basic.name\"\n            />\n            <small v-if=\"showErrors && basicErrors.name\" class=\"error\">Name is required.</small>\n          </label>\n\n          <label class=\"field\">\n            <span>Email</span>\n            <input\n              type=\"email\"\n              placeholder=\"jane@example.com\"\n              v-model=\"form.basic.email\"\n            />\n            <small v-if=\"showErrors && basicErrors.email\" class=\"error\">Please enter a valid email.</small>\n          </label>\n        </div>\n\n        <div v-else-if=\"currentStep === 1\" class=\"step\">\n          <h2 class=\"step-title\">Address</h2>\n\n          <label class=\"field\">\n            <span>Street</span>\n            <input\n              type=\"text\"\n              placeholder=\"123 Main St\"\n              v-model=\"form.address.street\"\n            />\n            <small v-if=\"showErrors && addressErrors.street\" class=\"error\">Street is required.</small>\n          </label>\n\n          <label class=\"field\">\n            <span>City</span>\n            <input\n              type=\"text\"\n              placeholder=\"Istanbul\"\n              v-model=\"form.address.city\"\n            />\n            <small v-if=\"showErrors && addressErrors.city\" class=\"error\">City is required.</small>\n          </label>\n\n          <label class=\"field\">\n            <span>Country</span>\n            <input\n              type=\"text\"\n              placeholder=\"T\u00fcrkiye\"\n              v-model=\"form.address.country\"\n            />\n            <small v-if=\"showErrors && addressErrors.country\" class=\"error\">Country is required.</small>\n          </label>\n\n          <label class=\"field\">\n            <span>Postal code (optional)</span>\n            <input\n              type=\"text\"\n              placeholder=\"34000\"\n              v-model=\"form.address.postalCode\"\n            />\n          </label>\n        </div>\n\n        <div v-else class=\"step\">\n          <h2 class=\"step-title\">Summary</h2>\n          <div class=\"summary\">\n            <h3>Basic info</h3>\n            <p><strong>Name:</strong> {{ form.basic.name || '\u2014' }}</p>\n            <p><strong>Email:</strong> {{ form.basic.email || '\u2014' }}</p>\n\n            <h3>Address</h3>\n            <p><strong>Street:</strong> {{ form.address.street || '\u2014' }}</p>\n            <p><strong>City:</strong> {{ form.address.city || '\u2014' }}</p>\n            <p><strong>Country:</strong> {{ form.address.country || '\u2014' }}</p>\n            <p><strong>Postal code:</strong> {{ form.address.postalCode || '\u2014' }}</p>\n          </div>\n        </div>\n      </section>\n\n      <footer class=\"actions\">\n        <button\n          type=\"button\"\n          class=\"ghost\"\n          @click=\"prev\"\n          :disabled=\"isFirstStep\"\n        >\n          Back\n        </button>\n\n        <button\n          v-if=\"!isLastStep\"\n          type=\"button\"\n          @click=\"next\"\n          :disabled=\"!canGoNext\"\n        >\n          Next\n        </button>\n\n        <button\n          v-else\n          type=\"button\"\n          class=\"primary\"\n          @click=\"submit\"\n          :disabled=\"!canSubmit\"\n        >\n          Submit\n        </button>\n      </footer>\n      <p v-if=\"submitMessage\" class=\"success\" role=\"status\">{{ submitMessage }}</p>\n    </section>\n  </main>\n</template>\n\n<script setup lang=\"ts\">\nimport { ref, reactive, computed } from 'vue';\n\n// 0 = basic, 1 = address, 2 = summary\nconst currentStep = ref(0);\n\n// Top-level form state (controlled inputs via v-model)\nconst form = reactive({\n  basic: { name: '', email: '' },\n  address: { street: '', city: '', country: '', postalCode: '' }\n});\n\nconst showErrors = ref(false);\nconst submitMessage = ref('');\n\n// Step-level validation\nconst basicErrors = computed(() => ({\n  name: form.basic.name.trim().length === 0,\n  email: form.basic.email.trim().length === 0\n}));\n\nconst isBasicValid = computed(() => !basicErrors.value.name && !basicErrors.value.email);\n\nconst addressErrors = computed(() => ({\n  street: form.address.street.trim().length === 0,\n  city: form.address.city.trim().length === 0,\n  country: form.address.country.trim().length === 0\n}));\n\nconst isAddressValid = computed(() => !addressErrors.value.street && !addressErrors.value.city && !addressErrors.value.country);\n\nconst isFirstStep = computed(() => currentStep.value === 0);\nconst isLastStep = computed(() => currentStep.value === 2);\n\nconst canGoNext = computed(() => {\n  if (currentStep.value === 0) return isBasicValid.value;\n  if (currentStep.value === 1) return isAddressValid.value;\n  return false;\n});\n\nconst canSubmit = computed(() => isBasicValid.value && isAddressValid.value);\n\nfunction next() {\n  submitMessage.value = '';\n  if (!canGoNext.value) {\n    showErrors.value = true;\n    return;\n  }\n\n  showErrors.value = false;\n  if (currentStep.value < 2) {\n    currentStep.value += 1;\n  }\n}\n\nfunction prev() {\n  submitMessage.value = '';\n  if (isFirstStep.value) return;\n  showErrors.value = false;\n  if (currentStep.value > 0) {\n    currentStep.value -= 1;\n  }\n}\n\nfunction submit() {\n  submitMessage.value = '';\n  const valid = canSubmit.value;\n  if (!valid) {\n    showErrors.value = true;\n    if (!isBasicValid.value) {\n      currentStep.value = 0;\n    } else if (!isAddressValid.value) {\n      currentStep.value = 1;\n    }\n    return;\n  }\n\n  console.log('submit() called with value:', JSON.parse(JSON.stringify(form)));\n  submitMessage.value = 'Signup submitted! Check the console for payload.';\n}\n</script>\n",
    "src/App.css": ":root {\n  color-scheme: dark;\n}\n\nhtml, body {\n  margin: 0;\n  height: 100%;\n  background: #020617;\n  font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;\n}\n\n.app {\n  min-height: 100vh;\n  display: grid;\n  place-items: center;\n  background: #020617;\n  color: #e5e7eb;\n  padding: 24px;\n}\n\n.card {\n  width: 100%;\n  max-width: 520px;\n  background: #020617;\n  border-radius: 16px;\n  border: 1px solid #1f2937;\n  padding: 20px 20px 16px;\n  display: grid;\n  gap: 16px;\n}\n\n.header h1 {\n  margin: 0;\n  font-size: 20px;\n  font-weight: 700;\n}\n\n.subtitle {\n  margin: 4px 0 0;\n  font-size: 13px;\n  color: #9ca3af;\n}\n\n.steps {\n  min-height: 260px;\n}\n\n.step {\n  display: grid;\n  gap: 12px;\n}\n\n.step-title {\n  margin: 0 0 4px;\n  font-size: 16px;\n  font-weight: 600;\n}\n\n.field {\n  display: grid;\n  gap: 4px;\n  font-size: 13px;\n}\n\n.field span {\n  color: #e5e7eb;\n}\n\n.field input {\n  border-radius: 10px;\n  border: 1px solid #374151;\n  background: #020617;\n  padding: 8px 10px;\n  color: #e5e7eb;\n  font-size: 14px;\n}\n\n.field input:focus {\n  outline: none;\n  border-color: #a3e635;\n}\n\n.error {\n  font-size: 11px;\n  color: #f97316;\n}\n\n.summary {\n  display: grid;\n  gap: 4px;\n  font-size: 14px;\n}\n\n.summary h3 {\n  margin: 8px 0 2px;\n  font-size: 14px;\n  font-weight: 600;\n  color: #e5e7eb;\n}\n\n.actions {\n  display: flex;\n  justify-content: space-between;\n  gap: 8px;\n  margin-top: 4px;\n}\n\n.actions button {\n  border-radius: 999px;\n  border: 1px solid #374151;\n  background: #020617;\n  color: #e5e7eb;\n  padding: 8px 16px;\n  font-size: 14px;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n.actions button.primary {\n  background: #a3e635;\n  color: #020617;\n  border-color: #a3e635;\n}\n\n.actions button[disabled] {\n  opacity: .5;\n  cursor: not-allowed;\n}\n\n.actions button.ghost {\n  background: transparent;\n}\n\n.success {\n  margin: -4px 0 0;\n  font-size: 13px;\n  color: #a3e635;\n  font-weight: 700;\n}\n",
    "tsconfig.json": "{\n  \"compilerOptions\": {\n    \"target\": \"ES2020\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"Node\",\n    \"strict\": true,\n    \"allowJs\": true\n  }\n}\n"
  }
}