  "dependencies": {
    "vue": "3.x"
  },
  "openFile": "/src/App.vue",
  "files": {
    "src/App.vue": "<template>\n  <main class=\"page\">\n    <section class=\"card\">\n      <h1 class=\"title\">Autocomplete</h1>\n\n      <div ref=\"rootRef\" class=\"combo\">\n        <label class=\"label\" for=\"q\">Search</label>\n        <input\n          id=\"q\"\n          class=\"input\"\n          type=\"text\"\n          autocomplete=\"off\"\n          placeholder=\"Type a city...\"\n          role=\"combobox\"\n          aria-autocomplete=\"list\"\n          :aria-expanded=\"isOpen\"\n          :aria-controls=\"listboxId\"\n          :aria-activedescendant=\"activeId\"\n          :value=\"query\"\n          @input=\"onInput\"\n          @focus=\"onFocus\"\n          @keydown=\"onKeyDown\"\n        />\n\n        <ul v-if=\"isOpen\" class=\"list\" role=\"listbox\" aria-label=\"City suggestions\" :id=\"listboxId\">\n          <li\n            v-for=\"(item, i) in results\"\n            :key=\"item\"\n            class=\"option\"\n            :class=\"{ active: i === activeIndex }\"\n            role=\"option\"\n            :id=\"optionId(item)\"\n            :aria-selected=\"i === activeIndex\"\n            @mousedown.prevent=\"select(item)\"\n            v-html=\"highlight(item, query)\"\n          />\n\n          <li v-if=\"status === 'loading'\" class=\"empty\">Loading…</li>\n          <li v-else-if=\"status === 'empty'\" class=\"empty\">No results</li>\n          <li v-else-if=\"status === 'error'\" class=\"empty empty--error\">Search failed</li>\n        </ul>\n\n        <p class=\"result-status\" aria-live=\"polite\">{{ resultStatus }}</p>\n      </div>\n\n      <p class=\"hint\">Keyboard: ↑/↓ navigate, Enter select, Esc close.</p>\n    </section>\n  </main>\n</template>\n\n<script setup lang=\"ts\">\nimport { computed, onBeforeUnmount, onMounted, ref, watch } from 'vue';\n\ntype Status = 'idle' | 'loading' | 'success' | 'empty' | 'error';\n\nconst listboxId = 'autocomplete-listbox';\n\nconst CITIES: string[] = [\n  'Amsterdam', 'Ankara', 'Athens', 'Austin',\n  'Barcelona', 'Berlin', 'Boston', 'Brussels',\n  'Chicago', 'Copenhagen',\n  'Dubai',\n  'Edinburgh',\n  'Frankfurt',\n  'Hamburg',\n  'Istanbul', 'Izmir',\n  'London', 'Los Angeles',\n  'Madrid', 'Miami', 'Milan', 'Munich',\n  'New York',\n  'Oslo',\n  'Paris', 'Prague',\n  'Rome',\n  'San Diego', 'San Francisco', 'San Jose', 'Seattle',\n  'Tokyo',\n  'Vienna',\n  'Zurich'\n];\n\nfunction sleep(ms: number, signal: AbortSignal) {\n  return new Promise<void>((resolve, reject) => {\n    const timerId = window.setTimeout(resolve, ms);\n    signal.addEventListener(\n      'abort',\n      () => {\n        window.clearTimeout(timerId);\n        reject(new DOMException('Search aborted', 'AbortError'));\n      },\n      { once: true }\n    );\n  });\n}\n\nconst rootRef = ref<HTMLElement | null>(null);\n\nconst query = ref('');\nconst status = ref<Status>('idle');\nconst isOpen = ref(false);\nconst activeIndex = ref(-1);\nconst results = ref<string[]>([]);\n\nconst activeId = computed(() => {\n  const current = results.value[activeIndex.value];\n  return current ? optionId(current) : undefined;\n});\n\nconst resultStatus = computed(() => {\n  if (status.value === 'loading') return 'Searching';\n  if (status.value === 'success') {\n    return results.value.length === 1 ? '1 result' : `${results.value.length} results`;\n  }\n  if (status.value === 'empty') return 'No results';\n  if (status.value === 'error') return 'Search failed';\n  return '';\n});\n\nconst cache = new Map<string, string[]>();\nlet debounceHandle: number | undefined;\nlet controller: AbortController | null = null;\nlet pickedQuery: string | null = null;\n\nfunction queryKey(rawQuery: string): string {\n  return rawQuery.trim().toLowerCase();\n}\n\nfunction cancelSearch() {\n  if (debounceHandle != null) {\n    window.clearTimeout(debounceHandle);\n    debounceHandle = undefined;\n  }\n  controller?.abort();\n  controller = null;\n}\n\nfunction showResults(next: string[]) {\n  results.value = next;\n  status.value = next.length ? 'success' : 'empty';\n  isOpen.value = true;\n  activeIndex.value = -1;\n}\n\nwatch(query, (next) => {\n  cancelSearch();\n\n  // A pick fills the input, but it is not a new search.\n  if (next === pickedQuery) {\n    pickedQuery = null;\n    return;\n  }\n\n  const key = queryKey(next);\n  results.value = [];\n  activeIndex.value = -1;\n\n  if (!key) {\n    status.value = 'idle';\n    isOpen.value = false;\n    return;\n  }\n\n  const remembered = cache.get(key);\n  if (remembered) {\n    showResults(remembered);\n    return;\n  }\n\n  status.value = 'loading';\n  isOpen.value = true;\n\n  const request = new AbortController();\n  controller = request;\n\n  debounceHandle = window.setTimeout(async () => {\n    debounceHandle = undefined;\n    try {\n      const data = await search(key, request.signal);\n      cache.set(key, data);\n      showResults(data);\n    } catch {\n      if (request.signal.aborted) return;\n      results.value = [];\n      status.value = 'error';\n    }\n  }, 300);\n});\n\nfunction onInput(e: Event) {\n  const el = e.target as HTMLInputElement | null;\n  pickedQuery = null;\n  query.value = el?.value ?? '';\n}\n\nfunction onFocus() {\n  if (status.value !== 'idle') isOpen.value = true;\n}\n\nfunction onKeyDown(ev: KeyboardEvent) {\n  if (ev.key === 'Escape') {\n    isOpen.value = false;\n    activeIndex.value = -1;\n    return;\n  }\n\n  if (ev.key === 'ArrowDown' || ev.key === 'ArrowUp') {\n    ev.preventDefault();\n    if (!isOpen.value) {\n      if (status.value !== 'idle') isOpen.value = true;\n      return;\n    }\n\n    const len = results.value.length;\n    if (len === 0) return;\n\n    if (ev.key === 'ArrowDown') {\n      activeIndex.value = activeIndex.value < 0 ? 0 : (activeIndex.value + 1) % len;\n    } else {\n      activeIndex.value = activeIndex.value < 0 ? len - 1 : (activeIndex.value - 1 + len) % len;\n    }\n    return;\n  }\n\n  if (ev.key === 'Enter' && isOpen.value && activeIndex.value >= 0) {\n    ev.preventDefault();\n    select(results.value[activeIndex.value]);\n  }\n}\n\nfunction select(value: string) {\n  cancelSearch();\n  pickedQuery = value;\n  query.value = value;\n  results.value = [];\n  status.value = 'idle';\n  isOpen.value = false;\n  activeIndex.value = -1;\n}\n\nfunction optionId(item: string): string {\n  return 'autocomplete-option-' + item.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');\n}\n\nfunction highlight(item: string, queryRaw: string): string {\n  const q = queryRaw.trim();\n  if (!q) return escapeHtml(item);\n\n  const idx = item.toLowerCase().indexOf(q.toLowerCase());\n  if (idx < 0) return escapeHtml(item);\n\n  const before = escapeHtml(item.slice(0, idx));\n  const mid = escapeHtml(item.slice(idx, idx + q.length));\n  const after = escapeHtml(item.slice(idx + q.length));\n  return `${before}<mark>${mid}</mark>${after}`;\n}\n\nfunction escapeHtml(s: string): string {\n  return s\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\\\"/g, '&quot;')\n    .replace(/'/g, '&#39;');\n}\n\nfunction onDocMouseDown(e: MouseEvent) {\n  const root = rootRef.value;\n  const target = e.target as Node | null;\n  if (!root || !target) return;\n  if (!root.contains(target)) {\n    isOpen.value = false;\n    activeIndex.value = -1;\n  }\n}\n\nonMounted(() => {\n  document.addEventListener('mousedown', onDocMouseDown);\n});\n\nonBeforeUnmount(() => {\n  document.removeEventListener('mousedown', onDocMouseDown);\n  cancelSearch();\n});\n\nasync function search(key: string, signal: AbortSignal): Promise<string[]> {\n  await sleep(150, signal);\n\n  if (key === 'error') {\n    throw new Error('Deterministic search failure');\n  }\n\n  return CITIES\n    .filter((c) => c.toLowerCase().includes(key))\n    .slice(0, 8);\n}\n</script>\n",
    "src/App.css": ":root {\n  color-scheme: dark;\n}\n\nhtml,body {\n  margin: 0;\n  height: 100%;\n  background: #0a0a0a;\n}\n\nbody {\n  font-family: system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;\n}\n\n.page {\n  min-height: 100vh;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n  background: #0a0a0a;\n  color: #e5e7eb;\n}\n\n.card {\n  width: 100%;\n  max-width: 520px;\n  background: #0b1020;\n  border: 1px solid #1f2937;\n  border-radius: 14px;\n  padding: 18px;\n  display: grid;\n  gap: 14px;\n}\n\n.title {\n  margin: 0;\n  font-size: 18px;\n  font-weight: 800;\n}\n\n.label {\n  display: block;\n  font-size: 12px;\n  color: #9ca3af;\n  margin-bottom: 6px;\n}\n\n.combo {\n  position: relative;\n}\n\n.input {\n  width: 100%;\n  padding: 12px 12px;\n  border-radius: 12px;\n  border: 1px solid #374151;\n  background: #0a0f1e;\n  color: #e5e7eb;\n  outline: none;\n}\n\n.input:focus {\n  border-color: #a3e635;\n  box-shadow: 0 0 0 2px rgba(163,230,53,.15);\n}\n\n.list {\n  position: absolute;\n  z-index: 10;\n  left: 0;\n  right: 0;\n  margin-top: 8px;\n  max-height: 240px;\n  overflow: auto;\n  border-radius: 12px;\n  border: 1px solid #1f2937;\n  background: #0a0f1e;\n}\n\n.option {\n  padding: 10px 12px;\n  cursor: pointer;\n  border-bottom: 1px solid rgba(31,41,55,.5);\n}\n\n.option:last-child {\n  border-bottom: none;\n}\n\n.option.active {\n  background: rgba(163,230,53,.12);\n}\n\n.empty {\n  padding: 10px 12px;\n  color: #9ca3af;\n}\n\n.hint {\n  margin: 0;\n  color: #9ca3af;\n  font-size: 12px;\n}\n\nmark {\n  background: rgba(163,230,53,.25);\n  color: #e5e7eb;\n  border-radius: 4px;\n  padding: 0 2px;\n}\n\n.empty--error {\n  color: #fecaca;\n}\n\n.result-status {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n  border: 0;\n}\n"
  }
}
